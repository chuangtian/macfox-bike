    "custom_html_zXNzVd": {
      "type": "custom-html",
      "disabled": true,
      "settings": {
        "code": "<style>\n    .max_width {\n        max-width: 1400px;\n        margin: 0 auto;\n    }\n\n    .cs_main_advantage {\n        display: flex;\n        width: 100%;\n        /* height: 48rem; */\n        background: #9E6E5B;\n        margin-bottom: 5.7rem;\n    }\n\n    .main_advantage_le {\n        width: 60%;\n        padding: 4.0rem 8.6rem 4rem 5.0rem;\n    }\n\n    .main_advantage_title {\n        font-weight: bold;\n        font-size: 4rem;\n        color: #FFFFFF;\n        line-height: 4.2rem;\n        letter-spacing: 3px;\n        margin-bottom: 20px;\n    }\n\n    .main_advantage_text {\n        font-weight: 500;\n        font-size: 1.8rem;\n        color: #FFFFFF;\n        line-height: 3rem;\n    }\n\n    .main_advanrage_ri {\n        width: 40%;\n        /* height: 100%; */\n    }\n\n    .main_advanrage_ri img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n    }\n\n    .cs_minor_advantage {\n        display: flex;\n        width: 100%;\n        height: 40rem;\n        margin-bottom: 120px;\n    }\n\n    .minor_advantage_le {\n        width: 55%;\n        height: 100%;\n    padding: 0 20px 20px 20px;\n    }\n\n    .minor_advantage_le img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n    }\n\n    .minor_advantage_ri {\n        position: relative;\n        width: 45%;\n        padding: 2.1rem 5rem;\n    }\n\n    .minor_advantage_title {\n        font-weight: 600;\n        font-size: 2.7rem;\n        color: #9E6E5B;\n        line-height: 3.6rem;\n        margin-bottom: 20px;\n    }\n\n    .minor_advantage_text {\n        font-weight: 400;\n        font-size: 1.6rem;\n        color: #4F4F4F;\n        line-height: 2.3rem;\n    }\n\n    .minor_advantage_dom {\n        align-items: end;\n        height: auto;\n    }\n\n    .minor_advantage_dom .minor_advantage_ri {\n        padding: 0;\n    }\n\n    .minor_advantage_ri img {\n        position: absolute;\n        bottom: 0;\n        left: 5rem;\n        width: calc(100% - 5rem);\n        height: 34.3rem;\n        object-fit: cover;\n    }\n\n    .cs_advantage_con {\n        display: flex;\n        justify-content: space-between;\n        flex-wrap: wrap;\n    }\n\n    .cs_advantage_item {\n        display: flex;\n        width: calc(50% - 25px);\n        height: 32.9rem;\n        padding: 2.9rem;\n        background: #F4F4F4;\n        margin-bottom: 50px;\n    }\n\n    .advantage_item_title {\n        font-weight: 600;\n        font-size: 2.9rem;\n        color: #9E6E5B;\n        line-height: 3.4rem;\n        margin-bottom: 20px;\n    }\n\n    .advantage_item_text {\n        font-weight: 400;\n        font-size: 1.3rem;\n        color: #4F4F4F;\n        line-height: 2.3rem;\n    }\n\n    .advantage_item_le {\n        width: 65%;\n        padding-right: 2.9rem;\n    }\n\n    .advantage_item_ri {\n        width: 35%;\n    }\n\n    .advantage_item_ri img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n    }\n\n    @media screen and (max-width: 769px) {\n\n        .max_width {\n            width: 100%;\n            padding: 0 12px;\n        }\n\n        .cs_main_advantage {\n            flex-direction: column-reverse;\n            flex-wrap: wrap;\n            height: 110vh;\n\n        }\n\n        .main_advantage_le {\n            width: 100%;\n            height: 60%;\n            padding: 20px;\n        }\n\n        .main_advantage_title {\n            font-weight: bold;\n            font-size: 40px;\n            color: #FFFFFF;\n            line-height: 48px;\n            letter-spacing: 1px;\n        }\n\n        .main_advanrage_ri {\n            width: 100%;\n            height: 40%;\n        }\n\n        .main_advantage_text {\n            font-size: 14px;\n            line-height: 26px;\n        }\n\n        .cs_minor_advantage {\n            flex-wrap: wrap;\n            height: 110vh;\n            margin-bottom: 30px;\n        }\n\n        .minor_advantage_le {\n            width: 100%;\n            height: 40%;\n        }\n\n        .minor_advantage_ri {\n            width: 100%;\n            height: 60%;\n            padding: 20px;\n        }\n\n        .minor_advantage_ri img {\n            position: inherit;\n            width: 100%;\n            height: 100%;\n            left: 0;\n        }\n\n        .minor_advantage_dom {\n            flex-direction: column-reverse;\n        }\n\n        .minor_advantage_dom .minor_advantage_le {\n            width: 100%;\n            height: 60%;\n            padding: 20px;\n        }\n\n        .minor_advantage_dom .minor_advantage_ri {\n            width: 100%;\n            height: 40%;\n        }\n\n        .cs_advantage_item {\n            display: flex;\n            flex-wrap: wrap;\n            width: 100%;\n            height: 500px;\n            padding: 20px;\n        }\n\n        .cs_advantage_item .advantage_item_le {\n            width: 100%;\n            height: 60%;\n            padding-right: 0;\n        }\n\n        .cs_advantage_item .advantage_item_ri {\n            width: 100%;\n            height: 40%;\n        }\n    }\n</style>\n\n<div class=\"max_width\">\n    <div class=\"cs_main_advantage\">\n        <div class=\"main_advantage_le\">\n            <h2 class=\"main_advantage_title\">\n                Fat Bikes for All Terrains\n            </h2>\n            <div class=\"main_advantage_text\">\n                The Macfox fat tire electric bike combines the rugged versatility of wide tires with the convenience of electric assistance, offering riders an exhilarating way to conquer any terrain. Whether you're navigating sandy beaches, snowy trails, or rough urban streets, the Macfox provides stability, traction, and effortless pedaling power. With features like adjustable suspension, powerful disc brakes, and customizable battery options, Macfox bikes are engineered for comfort, control, and durability. Whether you're commuting to work, exploring off-road trails, or embarking on urban adventures, the Macfox fat tire ebike is your reliable companion for every journey.\n            </div>\n        </div>\n        <div class=\"main_advanrage_ri\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0714/3581/3182/files/E-Bike-Customization.jpg?v=1709103407\" alt=\"Macfox Fat Tire Electric Bike\">\n        </div>\n    </div>\n\n    <div class=\"cs_minor_advantage\">\n        <div class=\"minor_advantage_le\">\n           <img src=\"https://cdn.shopify.com/s/files/1/0714/3581/3182/files/E-Bike-Trails-In-The-USA.jpg?v=1709007851\" alt=\"Macfox Long Range Electric Bike\">\n        </div>\n        <div class=\"minor_advantage_ri\">\n            <h2 class=\"minor_advantage_title\">\n                Maximizing Range:Dual Batteries Assist Long-distance Riding\n            </h2>\n            <div class=\"minor_advantage_text\">\n                Macfox long range ebikes are engineered to travel longer distances on a single charge, with high-capacity lithium-ion batteries typically ranging from 500Wh single cell to 1000Wh dual cell. These bikes are assisted by high-efficiency brushless motors and feature lightweight construction made of aluminum material. Advanced electronics optimize power delivery and monitor battery usage, providing real-time data on range and performance. Macfox electric bikes continue to improve range and performance through advances in battery technology and motor efficiency.\n            </div>\n        </div>\n    </div>\n\n    <div class=\"cs_minor_advantage minor_advantage_dom\">\n        <div class=\"minor_advantage_le\">\n            <h2 class=\"minor_advantage_title\">\n                Power Perfected: Macfox Bikes' Rear Motor System\n            </h2>\n            <div class=\"minor_advantage_text\">\n                The Macfox electric bike features a rear motor system, positioning its powerful propulsion unit at the rear wheel for optimal performance. This design choice embodies Macfox's commitment to innovation and engineering excellence, providing riders with a balanced and reliable riding experience. Whether navigating steep inclines or cruising through urban streets, the Macfox ebike's rear motor delivers smooth acceleration and responsive power delivery. With this advanced motor configuration, Macfox ensures that riders enjoy enhanced traction, efficiency, and control, making every journey an exhilarating adventure.\n            </div>\n        </div>\n        <div class=\"minor_advantage_ri\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0714/3581/3182/files/E-Bike-In-Urban-Environment.jpg?v=1706149284\" alt=\"Macfox rear motor\">\n        </div>\n    </div>\n</div>",
        "layout": "t4s-container-fluid",
        "cl_bg": "",
        "cl_bg_gradient": "",
        "mg": ",,50px,",
        "pd": "",
        "mg_mb": ",,30px,",
