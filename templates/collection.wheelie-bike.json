    "custom_page_faq_PBzFKw": {
      "type": "custom-page-faq",
      "blocks": {
        "faq_cyrUXc": {
          "type": "faq",
          "settings": {
            "faq_title": "What Is an Electric Bike?",
            "faq_content": "An electric bike is a bicycle equipped with an electric motor and battery that provides assistance while riding. It can be ridden using pedal power, motor power, or a combination of both, making riding easier and more enjoyable."
          }
        },
        "faq_MX7HhH": {
          "type": "faq",
          "settings": {
            "faq_title": "What Is the Range of an Electric Bike?",
            "faq_content": "The range of an electric bike depends on factors such as battery capacity, terrain, riding speed, and rider weight. Generally speaking, the range of the fat tire electric bike series launched by Macfox is 38-90 miles, and factors that affect the range of an electric bike include rider weight, the level of pedal assist used by the rider, how often the rider uses the throttle, terrain, speed, weather conditions, towing weight, etc."
          }
        },
        "faq_jtwADR": {
          "type": "faq",
          "settings": {
            "faq_title": "What Is the Top Speed of an Electric Bike?",
            "faq_content": "The top speed of an electric bike varies from model to model. Macfox electric bikes typically have a top speed of 25 to 28 miles per hour. For specific details, please refer to the product specifications of each model."
          }
        },
        "faq_xFEPMU": {
          "type": "faq",
          "settings": {
            "faq_title": "Who Can Ride an MACFOX Electric Bike?",
            "faq_content": "Electric bikes are suitable for teenagers and riding needs. Whether it is daily commuting, leisure riding or outdoor adventure, electric bikes can provide a convenient and comfortable riding experience."
          }
        },
        "faq_HNCVme": {
          "type": "faq",
          "settings": {
            "faq_title": "Do I Need a Driver's License to Ride an Electric Bike?",
            "faq_content": "In most countries and regions, you can ride an electric bike without a driver's license. However, specific regulations may vary, so it is recommended to check local laws and regulations before purchasing and using an electric bike."
          }
        },
        "faq_CTBRiy": {
          "type": "faq",
          "settings": {
            "faq_title": "What Is the Warranty Policy for Electric Bikes?",
            "faq_content": "We provide owners with a 2-year all-inclusive manufacturer warranty. Please refer to the product documentation or contact customer service for detailed <a href=\"https://macfoxbike.com/pages/general-warranty\" style=\"color: #3598db;\">warranty terms</a>."
          }
        },
        "faq_UyRxdh": {
          "type": "faq",
          "settings": {
            "faq_title": "How to Choose an Electric Bike That Is Right for Me?",
            "faq_content": "When choosing an electric bike, please consider your riding needs, budget, and intended use. Macfox offers a variety of options, including <a href=\"https://macfoxbike.com/products/macfox-x1\" style=\"color: #3598db;\">commuter ebike</a>, <a href=\"https://macfoxbike.com/products/macfox-x2\" style=\"color: #3598db;\">off road electric bike</a>, and <a href=\"https://macfoxbike.com/products/macfox-m19\" style=\"color: #3598db;\">kids electric bikes</a>, to meet different preferences and requirements. Whether you’re looking for a practical solution for daily commuting, an adventurous ride for rough terrains, or a safe and enjoyable option for your child, Macfox has the right model for you. Check product specifications and customer reviews to choose the model that best suits your needs."
          }
        }
      },
