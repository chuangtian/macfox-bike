          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style type=\"text/css\">\n    .t4s-click .t4s-eff-img- {\n        text-align: center;\n    }\n    \n    .pr_sw_btn {\n        border-radius: 4px;\n        border: 3px solid #fff;\n        background-color: transparent;\n    }\n    \n    .t4s_se_template--17772547277118__602619e3-8408-4b38-9f07-62da435a1135 .t4s-row,\n    .t4s_se_template--17772547309886__0e407ed0-7adf-4f7b-84b0-e8d171ff7164 .t4s-row {\n        align-items: flex-start;\n    }\n    \n    .pr_tabs {\n        max-width: 80%;\n    }\n    \n    .pr_tabs>span {\n        display: block;\n        font-size: 28px;\n        color: #fff;\n        margin-bottom: 20px;\n        padding: 0 15px;\n    }\n    \n    .pr_tabs_title {\n        display: flex;\n        justify-content: flex-start;\n        flex-wrap: wrap;\n    }\n    \n    .pr_tabs_title div {\n        flex: 0 0 50%;\n        max-width: 50%;\n        padding: 0 15px;\n        box-sizing: border-box;\n        margin-bottom: 10px;\n    }\n    \n    .pr_tabs_title span {\n        display: block;\n        text-align: center;\n        font-size: 14px;\n        color: #d0d1d2;\n        padding: 4px 24px;\n        box-sizing: border-box;\n        border: 3px solid #2c2c2c;\n        border-radius: 4px;\n        transition: 0.3s;\n    }\n    \n    .pr_tabs_title div.tab span {\n        border-color: #fff;\n    }\n    \n    .pr_tabs_content>.t2 {\n        display: none;\n        padding: 20px 15px;\n    }\n    \n    .pr_tabs_content>.t2:first-of-type {\n        display: block;\n    }\n    \n    .pr_tabs_content>.t2 .t4s-col-item {\n        margin-bottom: 24px;\n    }\n    \n    .pr_tabs_content>.t2 .t4s-col-item::before {\n        content: '';\n        display: block;\n        width: 32px;\n        height: 1px;\n        background-color: #eee;\n        margin-bottom: 12px;\n    }\n    \n    .pr_tabs_content>.t2 h5 {\n        font-size: 14px;\n        color: #fff;\n        font-weight: 600;\n        margin: 0 0 5px 0;\n    }\n    \n    .pr_tabs_content>.t2 p {\n        font-size: 14px;\n        color: #eee;\n        font-weight: 400;\n        margin: 0;\n    }\n    \n    @media (max-width: 767px) {\n        .pr_tabs {\n            width: 100%;\n        }\n        .pr_tabs>span {\n            padding: 0 7.5px; \n        }\n        .pr_tabs_title div {\n            padding: 0 7.5px;\n        }\n    }\n</style>   \n <div class=\"pr_tabs\">\n        <span>\n            <p><strong>Macfox-M19 Specs</strong> Specs</p>\n        </span>\n        <div class=\"pr_tabs_content\">\n            <div name=\"t1\" class=\"t2\">\n                <p><strong>Top Speed |</strong> 16 mph</p>\n                <p><br><strong>Range |</strong> 20 miles<br></p>\n                <p><br><strong>Charge Time |</strong>  5-6 hours</p>\n                <p><br><strong>Battery |</strong>&nbsp;36V 7.8Ah&nbsp;</p>\n                <p><br><strong>Motor |</strong>&nbsp;250W</p>\n                <p><br><strong>Peak power |</strong>&nbsp;500W</p>\n                <p><br><strong>Throttle |</strong>&nbsp;Thumb Throttle</p>\n                <p><br><strong>Max Payload |</strong>&nbsp;220lbs</p>\n                <p><br><strong>Brakes |</strong>&nbsp;Disc Brake</p>\n                <p><br><strong>Tire |</strong>&nbsp;16 inch</p>\n                <p><br><strong>Gearing |</strong>&nbsp;Single Speed</p>\n                <p><br><strong>Frame |</strong>&nbsp;Steel</p>\n                <p><br><strong>Headlight |</strong>&nbsp;LED Light</p>\n                <p><br><strong>Vehicle Weight |</strong>&nbsp;49lbs</p>\n            </div>\n        </div>\n    </div>"
