        "674f8d3b-cb73-447f-b69c-01265321eb36": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<div class=\"cs_tab_mark\">\n    <div class=\"cs_mark_con\">\n        <div class=\"cs_tab_item active\" data-index=\"0\">\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" class=\"cs_tab_svg\" viewBox=\"0 0 23.14 23.14\">\n                    <defs>\n                        <style>\n                            .cls-1 {\n                                fill: #000;\n                            }\n                        </style>\n                    </defs>\n                    <g id=\"图层_2\" data-name=\"图层 2\">\n                        <g id=\"图层_1-2\" data-name=\"图层 1\">\n                            <path class=\"cls-1\"\n                                d=\"M11.57,23.14A11.57,11.57,0,1,1,23.14,11.57,11.58,11.58,0,0,1,11.57,23.14ZM11.57,1a10.6,10.6,0,1,0,10.6,10.6A10.62,10.62,0,0,0,11.57,1Z\" />\n                            <path class=\"cls-1\"\n                                d=\"M13.92,6.08a3.67,3.67,0,0,1,1.59.36l-.93.92a1.35,1.35,0,0,0,0,1.91h0a1.35,1.35,0,0,0,1.93,0l.83-.81a3.62,3.62,0,0,1-3.42,4.83A3.83,3.83,0,0,1,12.56,13L8.9,16.67a1.38,1.38,0,0,1-1.94,0,1.36,1.36,0,0,1,0-1.91H7l3.64-3.61a3.51,3.51,0,0,1-.31-1.46,3.61,3.61,0,0,1,3.63-3.6Z\" />\n                        </g>\n                    </g>\n                </svg></div>\n            <div>2-Year Warranty</div>\n        </div>\n        <div class=\"cs_tab_item\" data-index=\"1\">\n            <div><svg xmlns=\"http://www.w3.org/2000/svg\" class=\"cs_tab_svg\" viewBox=\"0 0 23.14 23.14\">\n                    <defs>\n                        <style>\n                            .cls-1 {\n                                fill: #000;\n                            }\n                        </style>\n                    </defs>\n                    <g id=\"图层_2\" data-name=\"图层 2\">\n                        <g id=\"图层_1-2\" data-name=\"图层 1\">\n                            <path class=\"cls-1\"\n                                d=\"M11.57,18.38a.63.63,0,0,0,.64-.65V16.52a3