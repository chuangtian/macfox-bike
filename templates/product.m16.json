    "custom_page_faq_8fQpjD": {
      "type": "custom-page-faq",
      "blocks": {
        "faq_CQhnhk": {
          "type": "faq",
          "settings": {
            "faq_title": "Why Choose an Affordable Electric Bike?",
            "faq_content": "By choosing an affordable ebike like the Macfox X1S, you can enjoy the benefits of electric commuting without spending too much. It provides a cost-effective solution for daily commuting, helping you save on fuel and public transportation costs."
          }
        },
        "faq_HrYAbf": {
          "type": "faq",
          "settings": {
            "faq_title": "How Many Hours Does It Take to Fully Charge the X1S Electric Bike?",
            "faq_content": "The Macfox X1S takes about 5-6 hours to fully charge, making it convenient to charge overnight."
          }
        },
        "faq_9VXKgn": {
          "type": "faq",
          "settings": {
            "faq_title": "Am I Tall and Heavy Enough to Ride the X1S?",
            "faq_content": "The Macfox X1S is suitable for riders between 5’3” and 6’6” tall and can handle up to 300 pounds, so it fits a wide range of body types and ensures a comfortable riding experience."
          }
        },
        "faq_fkTTqc": {
          "type": "faq",
          "settings": {
            "faq_title": "Is the Macfox X1S a Great Electric Commuter Bicycle?",
            "faq_content": "Of course! The Macfox X1S is designed to be a great electric commuter bicycle. Its 500w nominal / 750w peak and 38-76+miles ensure you can handle your daily commute with ease, while its sturdy construction and versatile features make it a reliable and convenient choice for urban travel."
          }
        },
        "faq_gJdby7": {
          "type": "faq",
          "settings": {
            "faq_title": "Does the X1S Need to Be Assembled After Arrival?",
            "faq_content": "Partially assembled, you can download the manual or the assembly video released by Macfox."
          }
        }
      },
