    "custom_image_text_7EhPHE": {
      "type": "custom-image-text",
      "blocks": {
        "image_text_item_3K4q4g": {
          "type": "image_text_item",
          "settings": {
            "title": "500W Street-Legal Motor, Ride Without Worry",
            "content": "The M16 features a 500W motor that fully complies with U.S. Class 2 ebike laws, capped at 20mph for safe, legal riding on public roads.",
            "image": "shopify://shop_images/3_4fcd40d2-5eaf-4530-b3d0-c3ff8e5e1e29.webp",
            "image_mb": "shopify://shop_images/4_e100155a-7d5f-465f-879d-d8bebd1f126a.webp",
            "tag_label": "Quick Boost",
            "content_position": "left"
          }
        },
        "image_text_item_kcHCHN": {
          "type": "image_text_item",
          "settings": {
            "title": "Awesome Battery System",
            "content": "The M16’s 48V 10.4Ah lithium battery offers up to 25 miles per charge, keeping you free from range anxiety on commutes or weekend rides. Removable and built for performance, it makes every journey seamless.",
            "image": "shopify://shop_images/1_94768afb-24f9-4394-ad98-209ee66901f4.webp",
            "image_mb": "shopify://shop_images/5_063090d4-7512-442b-9f55-beb18ddf9b4c.webp",
            "tag_label": "Street Ready",
            "content_position": "left"
          }
        },
        "image_text_item_dEXXHF": {
          "type": "image_text_item",
          "settings": {
            "title": "Enhanced Front Suspension",
            "content": "Macfox M16 comes with killer front suspension, so when you're jumping obstacles or landing a wheelie, you stay smooth and in control.",
            "image": "shopify://shop_images/2_b79e5b6a-5b72-4f6f-a9b7-bb26af93340f.webp",
            "image_mb": "shopify://shop_images/6_81a235f4-efae-43d4-853d-58d536313051.webp",
            "tag_label": "Shock Absorber",
            "content_position": "left"
          }
        }
      },
      "block_order": [
