        "image_text_item_HPg37j": {
          "type": "image_text_item",
          "settings": {
            "title": "High-Carbon Steel Frame",
            "content": "The M16 is built with a tough high-carbon steel frame, ready to handle those wheelie impacts. The reinforced rear wheel supports keep you steady, so you can ride hard without worry.",
