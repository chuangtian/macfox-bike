    "custom_collections_describe_gMRkak": {
      "type": "custom-collections-describe",
      "blocks": {
        "describe_card_mjJeaD": {
          "type": "describe_card",
          "settings": {
            "title": "Power Designed for the Trail",
            "content": "Off-road riding demands responsive acceleration and torque. The Macfox X2 stands out with its dual-suspension frame and powerful motor, making uneven terrain feel smooth and manageable. The X7 provides fat-tire traction, perfect for loose soil and rocky paths."
          }
        },
        "describe_card_FX7BVr": {
          "type": "describe_card",
          "settings": {
            "title": "Smooth Control on Rough Surfaces",
            "content": "Throttle response and balanced geometry matter on trails. Macfox e-bikes offer predictable lift and steady handling so you can climb hills, cross rough patches, and maintain speed with confidence. The X1S gives a surprisingly smooth off-road experience for light trails and dirt roads."
          }
        },
        "describe_card_qW3Y6Q": {
          "type": "describe_card",
          "settings": {
            "title": "Adventure-Ready Build Quality",
            "content": "Every Macfox frame is built to take a beating — reinforced construction, quality brakes, and solid wheels handle real outdoor use. From weekend adventures to daily off-road commutes, your bike is engineered to stay strong."
          }
        },
        "describe_card_PA7xnE": {
          "type": "describe_card",
          "settings": {
            "title": "Explore More, Worry Less",
            "content": "Range, comfort, and durability matter when you're off the grid. Macfox off-road e-bikes balance power with practicality, letting you cover more miles with less effort. For younger or beginner off-road riders, the M16 offers stable control and lightweight handling."
          }
        }
      },
      "block_order": [
        "describe_card_mjJeaD",
        "describe_card_FX7BVr",
        "describe_card_qW3Y6Q",
        "describe_card_PA7xnE"
      ],
      "name": "Custom Collections Describe",
      "settings": {
        "title": "Off Road Ebike Overview",
        "describe": "Off-road e-bikes are designed for riders who crave adventure — forest trails, dirt paths, and backroads. With strong frames, powerful motors, and confidence-boosting traction, Macfox off-road models take you farther beyond the pavement. Experience the freedom to explore new terrain with stability and control."
      }
    },
    "custom_product_tabs_zy6jqD": {
      "type": "custom-product-tabs",
      "blocks": {
        "tab_item_BC78mP": {
          "type": "tab-item",
          "settings": {
            "title": "Are off-road e-bikes legal on hiking or nature trails?",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>It depends on local regulations. Many trails allow Class 1 or Class 2 e-bikes; always check posted rules.</p>"
          }
        },
        "tab_item_fxwnPf": {
          "type": "tab-item",
          "settings": {
            "title": "What makes an e-bike good for off-road riding?",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Suspension, traction, torque, and strong frames are key. Fat tires or dual-suspension help significantly.</p>"
          }
        },
        "tab_item_RyhTyF": {
          "type": "tab-item",
          "settings": {
            "title": "Which Macfox e-bike is best for off-road use?",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>The X2 is the most capable for tough trails, while the X7 excels when you need fat-tire traction.</p>"
          }
        },
        "tab_item_ixpqJE": {
          "type": "tab-item",
          "settings": {
            "title": "Can beginners ride off-road e-bikes?",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Absolutely. Start on simple dirt roads, learn throttle control, and gradually increase difficulty.</p>"
          }
        },
        "tab_item_ttdNgF": {
          "type": "tab-item",
          "settings": {
            "title": "Will off-road riding damage my bike?",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Not if the bike is built for it. Macfox frames, wheels, and components are designed to handle rough terrain.</p>"
          }
        }
      },
