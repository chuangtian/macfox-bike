    "custom_collections_describe_gMRkak": {
      "type": "custom-collections-describe",
      "blocks": {
        "describe_card_mjJeaD": {
          "type": "describe_card",
          "settings": {
            "title": "Designed for Urban Flow",
            "content": "Commuter e-bikes prioritize comfort and agility. Upright posture, stable geometry, and smooth pedal-assist help riders move confidently through traffic lights, bike lanes, and crowded areas. Ideal for predictable daily travel, a commuter ebike makes short and medium trips feel effortless."
          }
        },
        "describe_card_FX7BVr": {
          "type": "describe_card",
          "settings": {
            "title": "Confidence on Every Street",
            "content": "City streets change constantly—from potholes to uneven pavement. A commuter e bike absorbs these small impacts with stable wheels and balanced weight distribution. Riders appreciate the intuitive throttle feel and steady speed control, which keep stop-and-go movement smooth during busy commutes."
          }
        },
        "describe_card_qW3Y6Q": {
          "type": "describe_card",
          "settings": {
            "title": "Built for Everyday Reliability",
            "content": "Commuter e-bikes focus on lasting quality rather than complexity. Simple maintenance, durable frames, and dependable braking systems make them ideal for daily use. Whether your routine involves early-morning rides or late-evening returns, your electric bicycle is ready when you are."
          }
        },
        "describe_card_PA7xnE": {
          "type": "describe_card",
          "settings": {
            "title": "A Fit for Every Rider",
            "content": "From students and office commuters to casual weekend riders, commuter electric bikes adapt to different lifestyles. Lightweight models make city handling easy, while fat-tire commuter styles offer extra comfort and visibility. Riders choose based on the feel they prefer—not on overwhelming technical details."
          }
        }
      },
      "block_order": [
        "describe_card_mjJeaD",
        "describe_card_FX7BVr",
        "describe_card_qW3Y6Q",
        "describe_card_PA7xnE"
      ],
      "name": "Custom Collections Describe",
      "settings": {
        "title": "Commuter Electric Bike Overview",
        "describe": "A commuter electric bike is built to make everyday travel easier, faster, and more enjoyable. Whether you’re riding to work, navigating busy streets, or moving between neighborhoods, a commuter e-bike delivers smooth acceleration, upright comfort, and predictable handling. With pedal-assist and throttle-ready options across the Macfox lineup, each electric bicycle adapts to your city routine while keeping every ride efficient and stress-free."
      }
    },
    "custom_product_tabs_zy6jqD": {
      "type": "custom-product-tabs",
      "blocks": {
        "tab_item_BC78mP": {
          "type": "tab-item",
          "settings": {
            "title": "Are commuter electric bikes good for everyday city travel",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Yes. A commuter e-bike is designed for smooth starts, predictable handling, and comfortable posture—ideal for routine rides through urban areas.</p>"
          }
        },
        "tab_item_Hpchee": {
          "type": "tab-item",
          "settings": {
            "title": "Can a commuter ebike handle mixed conditions",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Most commuter electric bicycles perform well on typical city surfaces including uneven pavement, small bumps, and bike-lane transitions.</p>"
          }
        },
        "tab_item_DVY9cM": {
          "type": "tab-item",
          "settings": {
            "title": "How far can a commuter e bike ride on average",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Range depends on riding style and terrain. Pedal-assist generally extends distance, while frequent throttle use shortens it—this applies to all e-bikes.</p>"
          }
        },
        "tab_item_hNdTYC": {
          "type": "tab-item",
          "settings": {
            "title": "Are commuter e-bikes beginner-friendly",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Absolutely. The stable geometry and smooth power delivery make commuter electric bikes ideal for first-time riders.</p>"
          }
        },
        "tab_item_93FcMt": {
          "type": "tab-item",
          "settings": {
            "title": "Are commuter ebikes easy to maintain",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Yes. Routine checks on brakes, tires, and battery health are usually enough to keep a commuter electric bike running reliably.</p>"
          }
        }
      },
