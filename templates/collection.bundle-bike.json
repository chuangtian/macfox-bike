    "custom_collections_community_L76mjK": {
      "type": "custom-collections-community",
      "blocks": {
        "comment_card_9h7T6f": {
          "type": "comment_card",
          "settings": {
            "comment": "“Love the bike! Very comfortable and I love the brakes and fat tires. It is quite a bit slower to get up to speed compared to all my kids x1 bikes but I do like it. Also the throttle switch does stick quite a bite. But we love our bikes! We have 4 of these EBikes”",
            "img": "shopify://shop_images/4_99e8c581-4e66-44e9-bdea-6a0ed7902568.webp",
            "name": "Chris E.",
            "product": "macfox-x7"
          }
        },
        "comment_card_GMciQA": {
          "type": "comment_card",
          "settings": {
            "comment": "“We ordered this electric bike on line and it has been great. It was great speed and it has been so helpful for my son to get around with no issues. Also has been very safe for him to use. Also want to mention the amazing Customer Service we have received from Macfox when needed. Paulina has been so responsive and answers are questions on a timely manner. Thank you 😊\"",
            "img": "shopify://shop_images/5_c661bb5a-1934-4674-8651-ce479fdfbe51.webp",
            "name": "Catalina G.",
            "product": "macfox-x1"
          }
        },
        "comment_card_gzLdjU": {
          "type": "comment_card",
          "settings": {
            "comment": "“Best bike ever I had all 3 models x1 and x1s and x2 have to say the x2 is a good upgrade definitely worth the extra money !\"",
            "img": "shopify://shop_images/2_e4810802-5573-4e7f-8829-e774bb5be5ed.webp",
            "name": "Israel C.",
            "product": "macfox-x2"
          }
        },
        "comment_card_4ibE8K": {
          "type": "comment_card",
          "settings": {
            "comment": "“This bike is super sick! The lower seat height makes it super nice and comfy since I’m a shorter guy. It wheelies straight out of the box super well and the thicker wheels makes it feel like I have full control over the bike. The 13 amp battery gives me 20+ miles of hardcore riding and the brakes have insane stopping power. I would highly recommend buying this awesome bike!\"",
            "img": "shopify://shop_images/6_cf7eb899-5107-49cf-ae55-8921b7254890.webp",
            "name": "Jacob P.",
            "product": "macfox-x7"
          }
        },
        "comment_card_wYa4yn": {
          "type": "comment_card",
          "settings": {
            "comment": "“Bought the macfox x7 for my son’s 14th birthday. It’s was super easy to put together. He absolutely loves it! It’s perfect for riding around the neighborhood and going to friends houses.”",
            "img": "shopify://shop_images/3_e24db871-3c80-4ae0-8423-dc424412cfee.webp",
            "name": "Laura M.",
            "product": "macfox-x7"
          }
        },
        "comment_card_HahxMa": {
          "type": "comment_card",
          "settings": {
            "comment": "“Great bike for my 13 year olds! Arrived very quickly and was easy to assemble (the kids built it themselves). It’s been fun and safe to ride to school and around town.”",
            "img": "shopify://shop_images/1_d6dc3ff1-d44b-4c5c-ac32-a21fdc1e0cc9.webp",
            "name": "Erin R.",
            "product": "macfox-x1"
          }
        },
        "comment_card_keEe34": {
          "type": "comment_card",
          "settings": {
            "comment": "“Shopping was way quicker than expected and the bike looks sharp!! My son will be so excited to receive this for his 13th birthday next weekend!”",
            "img": "shopify://shop_images/1_a6e73b7b-04f3-40be-9853-0e89b3f6dcab.webp",
            "name": "Krystle F.",
            "product": "macfox-x1"
          }
        }
