    "custom_collections_describe_LUnUgC": {
      "type": "custom-collections-describe",
      "blocks": {
        "describe_card_ERe7af": {
          "type": "describe_card",
          "settings": {
            "title": "Best for Fat Tire Street Riding",
            "content": "Choose the <strong>Macfox X7</strong> if you want a bold <strong>street-style electric bike</strong> with <strong>5.0\" fat tires</strong> and a more planted feel. It works well for <strong>city streets</strong>, neighborhood rides, and light mixed surfaces."
          }
        },
        "describe_card_zTj9jT": {
          "type": "describe_card",
          "settings": {
            "title": "Best for Daily Commuting",
            "content": "Choose the <strong>Macfox X1S</strong> if you want a balanced <strong>city eBike</strong> for everyday trips, <strong>short commutes</strong>, school runs, and frequent stops. It keeps the ride simple with stable handling, <strong>thumb throttle control</strong>, and a comfortable fit for riders <strong>5'3\" and up</strong>."
          }
        },
        "describe_card_DfmK8E": {
          "type": "describe_card",
          "settings": {
            "title": "Best for Longer Range",
            "content": "Choose the <strong>Macfox X2</strong> if you want the <strong>longest Macfox range option</strong>, especially with the <strong>dual-battery setup</strong>. It is better for riders who want fewer charging stops, more comfort on longer routes, and stronger control from <strong>full suspension</strong>."
          }
        },
        "describe_card_qe3FQx": {
          "type": "describe_card",
          "settings": {
            "title": "Best for Smaller or Younger Riders",
            "content": "Choose the <strong>Macfox M16</strong> if you need an <strong>easier fit</strong>, compact size, and simple everyday control. It is the most approachable Macfox electric bike for <strong>smaller riders</strong>, starting from <strong>3'11\" and up</strong>."
          }
        }
      },
