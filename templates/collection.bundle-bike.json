    "custom_collections_describe_gMRkak": {
      "type": "custom-collections-describe",
      "blocks": {
        "describe_card_mjJeaD": {
          "type": "describe_card",
          "settings": {
            "title": "Comfort, Power & Everyday Performance",
            "content": "Every <strong>electric bike</strong> is built to balance <strong>comfort</strong> with real-world <strong>performance</strong>. Rear-drive motors deliver smooth acceleration, while <strong>long-range battery options</strong> support longer daily rides. Stable handling and intuitive controls make each ride predictable across <strong>city routes</strong> and mixed terrain."
          }
        },
        "describe_card_FX7BVr": {
          "type": "describe_card",
          "settings": {
            "title": "Built for Reliability, Ready for Your Daily Ride",
            "content": "From lightweight frames to durable builds, these <strong>electric bikes</strong> are made for everyday use. Disc brakes provide reliable stopping power in urban conditions, while each model is designed for <strong>consistent performance</strong> in traffic, bike paths, and daily commuting."
          }
        },
        "describe_card_qW3Y6Q": {
          "type": "describe_card",
          "settings": {
            "title": "Street-Style Design for City Riders",
            "content": "More than just an <strong>electric bike</strong> brand, Macfox represents a growing community of riders. From commuters to weekend explorers, riders value <strong>freedom</strong>, <strong>practical performance</strong>, and the evolution of <strong>urban electric mobility</strong>."
          }
        },
        "describe_card_PA7xnE": {
          "type": "describe_card",
          "settings": {
            "title": "Join the Macfox Community",
            "content": "Macfox is more than an e-bike brand — it’s a growing community of riders redefining how they move through the <strong>city</strong>. From students to professionals, commuters to weekend explorers, our riders value freedom, individuality, and <strong>practical performance</strong>. Together, we’re shaping the next chapter of <strong>urban electric mobility</strong>."
          }
        }
      },
      "block_order": [
