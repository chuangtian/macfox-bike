    "custom_product_describe_card_3XUrEQ": {
      "type": "custom-product-describe-card",
      "blocks": {
        "product_describe_item_pJM33h": {
          "type": "product_describe_item",
          "settings": {
            "content": "<span>The 500W motor, peaking at 750W, offers the perfect balance of power and street legality.</span>\nExperience torque-packed rides with 20mph top speed, so you can cruise public roads worry-free.",
            "desc": "",
            "image": "shopify://shop_images/72e98730358f9ca17d97ce83614537f6_6cf735fd-1c64-4cbf-9a1c-6049109e325e.webp",
            "image_mobile": "shopify://shop_images/72e98730358f9ca17d97ce83614537f6_6cf735fd-1c64-4cbf-9a1c-6049109e325e.webp"
          }
        },
        "product_describe_item_3ejtBq": {
          "type": "product_describe_item",
          "disabled": true,
          "settings": {
            "content": "The bike frame is carefully designed to support a natural riding posture, protecting the developing spine of youth while effectively reducing fatigue during long rides. This ensures both comfort and safety for the rider.",
            "desc": "",
            "image": "shopify://shop_images/1_130b55fd-999a-4bb7-a49c-beef23c9e0e0.webp",
            "image_mobile": "shopify://shop_images/1_130b55fd-999a-4bb7-a49c-beef23c9e0e0.webp"
          }
        },
        "product_describe_item_pK9R3A": {
          "type": "product_describe_item",
          "settings": {
            "content": "Lab testing shows that the X7 e-bike can achieve up to <span>35 miles</span> of range on a full charge under standard test conditions, including an average rider weight and steady cruising in second gear.<br><br>\n\nWith a dual-battery setup, the total range can be extended up to <span>70 miles</span>.",
            "desc": "*MACFOX battery interfaces are fully compatible, allowing you to upgrade to higher-capacity batteries for extendedrange. However, please note that the selected battery capacity must not be lower than the standard battery to ensurebike performance and safety.<br><br>UL 2271 Certified (Single battery configuration) ※ Dual battery system exceeds standard UL scope For Dual Battery orders, the second battery will be shipped separately.",
            "image": "shopify://shop_images/bd34af0629b900eeb34e182960688bef_0588fb68-ca95-448f-a2d1-576576e2f160.webp",
            "image_mobile": "shopify://shop_images/bd34af0629b900eeb34e182960688bef_0588fb68-ca95-448f-a2d1-576576e2f160.webp"
          }
        },
        "product_describe_item_9zmFfg": {
          "type": "product_describe_item",
          "settings": {
            "content": "<span>Custom 20x4.5'' front and 20x5.0'' rear fat tires are the widest on the market, delivering unmatched safety and stability.</span> Their bold size gives the bike a cooler stance, and the R&amp;D team calls it the little monster of the road.",
            "desc": "",
