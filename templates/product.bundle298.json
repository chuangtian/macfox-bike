    "custom_product_tabs_tHm8ji": {
      "type": "custom-product-tabs",
      "blocks": {
        "tab_item_kcEGPU": {
          "type": "tab-item",
          "settings": {
            "title": "IN THE BOX",
            "t_icon": "<svg viewbox=\"0 0 35 35\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M17.5 33L4.10001 25.2V9.8L17.5 2L30.9 9.7V25.2L17.5 33ZM6.20001 24L17.5 30.5L28.8 24V11L17.5 4.5L6.20001 11V24Z\" fill=\"white\"></path>\n<path d=\"M17.5 18.7L4.60001 11.3L5.70001 9.5L17.5 16.3L25.9 11.5L25.5 14.1L17.5 18.7Z\" fill=\"white\"></path>\n<path d=\"M18.6 17.5H16.5V31.8H18.6V17.5Z\" fill=\"white\"></path>\n<path d=\"M13.6 21L8.90001 18.3V15.9L13.6 18.6V21Z\" fill=\"white\"></path>\n<path d=\"M12.0164 5.76269L10.9382 7.5647L23.1233 14.855L24.2014 13.053L12.0164 5.76269Z\" fill=\"white\"></path>\n</svg>",
            "t_color": "#ffffff",
            "content": "<h6><strong>Standard Package:</strong></h6><p>1x Macfox Electric Bike<br/>1x Headlight<br/>1x Taillight<br/>1x Battery<br/>1x Charger<br/>1x Installation Tools<br/>1x User Manual</p><h6><strong>Optional accessories (not included):</strong></h6><p>Bag<br/>One extra battery</p>"
          }
