    "custom_collections_describe_gMRkak": {
      "type": "custom-collections-describe",
      "blocks": {
        "describe_card_mjJeaD": {
          "type": "describe_card",
          "settings": {
            "title": "Go Farther With Less Effort",
            "content": "Long-range e-bikes support extended rides with consistent motor assistance. Riders enjoy smoother climbs, steady cruising speeds, and the freedom to explore longer distances, whether for daily commuting or weekend trips."
          }
        },
        "describe_card_FX7BVr": {
          "type": "describe_card",
          "settings": {
            "title": "Comfort Matters on Long Rides",
            "content": "Ergonomics become essential when you’re riding for miles. Long-range electric bicycles use balanced geometry and supportive seating to reduce fatigue. Whether you're on paved routes or light trails, comfort directly enhances overall range."
          }
        },
        "describe_card_qW3Y6Q": {
          "type": "describe_card",
          "settings": {
            "title": "Built for Distance and Durability",
            "content": "A long-distance ebike emphasizes dependable performance. Strong frames, stable wheels, and predictable braking create confidence on longer routes. Riders value reliability as much as battery life during extended journeys."
          }
        },
        "describe_card_PA7xnE": {
          "type": "describe_card",
          "settings": {
            "title": "Versatile for Urban and Outdoor Riding",
            "content": "A long-range e bike works across different environments—city roads, countryside paths, and scenic routes. Riders choose long-range models not only for mileage, but for the flexibility to explore multiple surfaces with ease."
          }
        }
      },
      "block_order": [
        "describe_card_mjJeaD",
        "describe_card_FX7BVr",
        "describe_card_qW3Y6Q",
        "describe_card_PA7xnE"
      ],
      "name": "Custom Collections Describe",
      "settings": {
        "title": "Long Range Electric Bike Overview",
        "describe": "A long-range electric bike is built for riders who want to go farther—whether exploring backroads, commuting across town, or taking weekend routes without worrying about the next charge. Long-distance e-bikes combine efficient power output with comfortable design, making every trip smoother and more capable. With multiple riding styles across the Macfox lineup, each electric bicycle offers a balance of endurance, confidence, and ease for those who travel beyond the usual path."
      }
    },
    "custom_product_tabs_zy6jqD": {
      "type": "custom-product-tabs",
      "blocks": {
        "tab_item_BC78mP": {
          "type": "tab-item",
          "settings": {
            "title": "What defines a long-range electric bike",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>A long-range e-bike is designed with efficient power delivery and larger battery capacity, allowing riders to travel significantly farther than standard electric bicycles.</p>"
          }
        },
        "tab_item_Hpchee": {
          "type": "tab-item",
          "settings": {
            "title": "How far can a long-range e bike go",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Actual distance depends on terrain, weather, riding mode, and throttle use. Pedal-assist generally maximizes range, as with most ebikes.</p>"
          }
        },
        "tab_item_DVY9cM": {
          "type": "tab-item",
          "settings": {
            "title": "Are long-range electric bikes good for commuting",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Yes. Many commuters enjoy riding multiple days between charges and appreciate not needing to recharge after every trip.</p>"
          }
        },
        "tab_item_hNdTYC": {
          "type": "tab-item",
          "settings": {
            "title": "Can long-range e-bikes handle varied terrain",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Most long-range electric bikes perform well on mixed surfaces. Riders often choose models with comfortable geometry for extended hours on the saddle.</p>"
          }
        },
        "tab_item_93FcMt": {
          "type": "tab-item",
          "settings": {
            "title": "How do I keep my electric bicycle's battery performing well",
            "t_icon": "",
            "t_color": "#ffffff",
            "content": "<p>Store it in moderate temperatures, avoid letting it fully drain, and follow routine charging habits. Consistent care helps maintain long-term range.</p>"
          }
        }
      },
      "block_order": [
