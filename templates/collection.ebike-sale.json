    "custom_collections_describe_img_VYGgXz": {
      "type": "custom-collections-describe_img",
      "blocks": {
        "dealer_PYDANB": {
          "type": "dealer",
          "settings": {
            "title": "Find the Right Macfox for School",
            "content": "<p>Choose by rider fit first, then by riding needs. </p><p>The M16 is ideal for younger or smaller riders who want a lower, easy-to-control frame. The X1S is a comfortable everyday option for school commutes and neighborhood rides. The X7 offers wider tires, a roomier feel, and steadier handling. The X2 Pro combines full suspension with more power, making it ideal for longer rides and more demanding routes.</p>",
            "img": "shopify://shop_images/DSC00394.webp",
            "position": "rtl"
          }
        },
        "dealer_VAAaL9": {
          "type": "dealer",
          "settings": {
            "title": "Why Buy During the Back to School Sale",
            "content": "<p>Back-to-school season is a great time to choose an e-bike. It gives families more flexibility with school transportation while helping students stay active, connect with friends, and build confidence and independence.Get $100 off the X1S, X7, and X2 Pro. </p><p>Get $50 off the M16. Plus, receive a free accessory bundle with any bike purchase while supplies last.</p>",
            "img": "shopify://shop_images/1_f1dd4b25-cc3c-4b2e-9b14-eca758d1ee48.webp",
            "position": "ltr"
          }
        }
      },
      "block_order": [
        "dealer_PYDANB",
        "dealer_VAAaL9"
      ],
      "name": "Distributor Img",
      "settings": {}
    },
    "custom_collections_describe_Kfwbmy": {
      "type": "custom-collections-describe",
      "disabled": true,
      "name": "Custom Collections Describe",
      "settings": {
        "title": "Find Your Macfox",
        "describe": "From easy city commutes to longer weekend adventures, every Macfox model brings a different kind of ride to the season. X1S is built for everyday mobility with street-ready style, X2 is made for riders who want more off-road confidence and all-terrain capability, X7 / X7L offer a more stable and powerful feel for longer rides, and M16 brings a more approachable fit for younger or smaller riders. This Easter is the perfect time to choose the model that matches the way spring is meant to be ridden.2"
      }
    },
    "custom_collections_describe_gMRkak": {
      "type": "custom-collections-describe",
      "blocks": {
