      "name": "Custom Collections Describe",
      "settings": {
        "title": "Why Buy This Easter",
        "describe": "Easter is one of the best times to buy an e-bike in the U.S., with spring riding season just beginning and limited-time savings available before demand picks up. With warmer weather, longer days, and more outdoor plans ahead, now is the right time to save and start riding."
      }
    },
