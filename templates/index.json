    "custom_collections_describe_ymUYDm": {
      "type": "custom-collections-describe",
      "name": "Custom Collections Describe",
      "settings": {
        "title": "<strong>UL Certification</strong>",
        "describe": "All Macfox  bikes are certified to applicable UL safety standards for e-bikes and battery systems. These certifications address critical requirements related to electrical performance and battery fire safety.<br><br>UL certification means that key components—such as batteries, chargers, and electrical systems—have been evaluated against established safety standards through independent testing. As a result, Macfox  bikes meet the safety requirements necessary for legal sale in regulated markets, including California,New York City where UL certification is required.<br><br>For more information about UL standards and certifications, please visit the UL official website."
      }
    },
