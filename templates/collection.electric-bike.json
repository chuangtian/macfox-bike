        "describe_card_zTj9jT": {
          "type": "describe_card",
          "settings": {
            "title": "Daily Commuting",
            "content": "For short commutes, errands, and frequent stops, the Macfox X1S is the most balanced city-focused option in the lineup.<br><br><a href=\"https://macfoxbike.com/products/macfox-x1\"><strong>View Macfox X1S →</strong></a> or <a href=\"https://macfoxbike.com/products/x1s-x-bs-zay\"><strong>X1S x Bs.zay →</strong></a>"
          }
        },
        "describe_card_DfmK8E": {
          "type": "describe_card",
          "settings": {
            "title": "Longer Mixed-Terrain Rides",
            "content": "For longer routes and uneven surfaces, the Macfox X2 Pro combines full suspension with dual-battery range options for added comfort and fewer charging stops.<br><br><a href=\"https://macfoxbike.com/products/macfox-x2\"><strong>Explore Macfox X2 Pro →</strong></a>"
          }
        },
        "describe_card_qe3FQx": {
          "type": "describe_card",
          "settings": {
            "title": "Compact Rider Fit",
            "content": "For riders who prefer a smaller, easier-to-handle frame, the Macfox M16 is the most compact option for neighborhood rides and everyday trips.<br><br><a href=\"https://macfoxbike.com/products/macfox-m16-ebike\"><strong>Check Macfox M16 Fit →</strong></a>"
          }
        }
      },
