      "type": "custom-collections-describe",
      "blocks": {
        "describe_card_ERe7af": {
          "type": "describe_card",
          "settings": {
            "title": "Fat-Tire Street Riding",
            "content": "For neighborhood streets and light mixed surfaces, the Macfox X7 combines extra-wide fat tires with a stable, planted ride.<br><br><a href=\"https://macfoxbike.com/products/macfox-x7\"><strong>Explore Macfox X7 &amp; X7L →</strong></a>"
