<!doctype html>
{%- liquid
  if settings.use_rtl == '1'
    assign isRTL = true
  elsif settings.use_rtl == '2' and settings.list_rtl contains request.locale.iso_code
    assign isRTL = true
  else
    assign isRTL = false
  endif
  assign body_img = settings.body_bg_image
  if body_img != blank and settings.general_layout == 'boxed'
    assign class_lazy = 'lazyloadt4s'
  endif
-%}

{%- capture class_html -%}
t4sp-theme t4s-wrapper__{{settings.general_layout}} rtl_{{isRTL}} swatch_color_style_{{settings.swatch_color_style}} pr_border_style_{{settings.pr_border_style}} pr_img_effect_{{settings.pr_img_effect}} enable_eff_img1_{{settings.enable_eff_img1}} badge_shape_{{settings.badge_shape}} css_for_wis_app_{{settings.enable_css_wis}}{% if settings.use_cus_lz and settings.cus_lz %} t4s-lzcus-true{% endif %} shadow_round_img_{{settings.enable_shadow_round_img}} t4s-header__{{settings.header_design}} is-remove-unavai-{{settings.variant_remove}} t4_compare_{{settings.enable_compe}} is-catalog__mode-{{settings.catalog_mode}}
{%- endcapture -%}
<html
  class="{{class_html}} no-js"
  lang="{{ request.locale.iso_code }}"
  {% if isRTL %}
    dir="rtl"
  {% endif %}
>
  <head>
    {%- comment -%}
      LCP 主图预加载：产品页主图位于 HTML 第 ~257KB 处，预加载扫描器需解析完整个 head 才能发现它，
      实测造成 1556ms 的 resource load delay。此处提前声明，imagesrcset/imagesizes 必须与
      sections/custom-product-main.liquid 里 .product_img 的 srcset/sizes 完全一致才能命中同一请求。
    {%- endcomment -%}
    {%- if request.page_type == 'product' -%}
      {%- liquid
        assign lcp_variant = product.selected_or_first_available_variant
        assign lcp_img = lcp_variant.featured_image | default: product.featured_image
      -%}
      {%- if lcp_img != blank -%}
        <link
          rel="preload"
          as="image"
          fetchpriority="high"
          href="{{ lcp_img | image_url: width: 1200 }}"
          imagesrcset="{{ lcp_img | image_url: width: 400 }} 400w, {{ lcp_img | image_url: width: 800 }} 800w, {{ lcp_img | image_url: width: 1200 }} 1200w"
          imagesizes="(max-width: 767px) 80vw, 45vw"
        >
      {%- endif -%}
    {%- endif -%}

    <link rel="stylesheet" href="{{ 'main.css' | asset_url }}">
    <script type="module" src="{{ 'main.min.js' | asset_url }}"></script>

    <script>
  !function(w, d, s, u) {
    if (w.oaiq) return;
    var q = function() {
      q.q.push(arguments);
    };
    q.q = [];
    w.oaiq = q;
    var j = d.createElement(s);
    j.async = 1;
    j.src = u;
    var f = d.getElementsByTagName(s)[0];
    f.parentNode.insertBefore(j, f);
  }(window, document, "script", "https://bzrcdn.openai.com/sdk/oaiq.min.js");

  oaiq("init", {
    pixelId: "BZ3bzcvYvvgbvi9JWzmQvX",
  });
</script>


    {% comment %} SEO Hreflang {% endcomment %}
    {% if product %}
      {% assign hreflang = product.metafields.custom.seo_hreflang.value.links.value %}
    {% elsif page %}
      {% assign hreflang = page.metafields.custom.seo_hreflang.value.links.value %}
    {% elsif collection %}
      {% assign hreflang = collection.metafields.custom.seo_hreflang.value.links.value %}
    {% elsif request.page_type == 'index' %}
      {% assign hreflang = shop.metaobjects.seo_hreflang.home.links.value %}
    {% endif %}
    {{ hreflang }}
    {% include 'canonicals_app' %}

    {%- render 'ecom_header' -%}
    <meta name="p:domain_verify" content="4031115eacdc43df982d7d16009b85d0">
    <!-- Added by AVADA SEO Suite -->
    {% include 'avada-seo' %}

    <!-- Google tag (gtag.js) -->
    {% comment %} <script async src="https://www.googletagmanager.com/gtag/js?id=AW-11102389732"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'AW-11102389732');
    </script> {% endcomment %}

