    {% if request.path contains '/tagged/' %}
      {% assign seo_re_mark = request.path | split: '/' | last %}
      {% assign seo_re_title = '' %}
      {% assign seo_re_description = '' %}
      {% for item in blog.metafields.custom.seorearr.value %}
        {% if seo_re_mark == item.url %}
          {% assign seo_re_title = item.title %}
          {% assign seo_re_description = item.description %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    <script>
      (function () {
        const a = function (f, a, b) {
            const c = new Date();
            c.setTime(c.getTime() + 1e3 * (60 * (60 * (24 * b))));
            let e = 'expires=' + c.toUTCString();
            document.cookie = f + '=' + a + ';' + e + ';path=/';
          },
          b = new URLSearchParams(window.location.search),
          c = b.entries(),
          d = {};
        for (const [e, a] of c) d[e] = a;
        if (d.sca_ref) {
          const b = d.sca_ref.split('.');
          a('scaaf_aid', b[0]),
            a('scaaf_hc', b[1]),
            localStorage.setItem('scaaf_aid', b[0]),
            localStorage.setItem('scaaf_hc', b[1]),
            localStorage.setItem('scaaf_received', 'false'),
            console.log(
              '%c \u25BA Uppromote Affiliate Marketing: (Stored cookie)',
