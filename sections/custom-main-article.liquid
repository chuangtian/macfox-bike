{%- comment -%}
  Comments may not appear right after they are submitted, either to be checked by Shopify's spam filter
  or to await moderation. When a comment is submitted, the browser is redirected to a page
  that includes the new comment id in its URL.
    Example: http://shopname.myshopify.com/blogs/news/2022072-my-post?comment=3721372
{%- endcomment -%}
<!-- sections/main-article.liquid -->
{{ 'section.css' | asset_url | stylesheet_tag }}
{{ 'button-style.css' | asset_url | stylesheet_tag }}
<link href="{{ 'custom-effect.css' | asset_url }}" rel="stylesheet" media="print" onload="this.media='all'">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap"
  rel="stylesheet"
>

<style>
  .crimson-text-regular {
    font-family: 'Crimson Text', serif;
    font-weight: 400;
    font-style: normal;
  }

  .crimson-text-semibold {
    font-family: 'Crimson Text', serif;
    font-weight: 600;
    font-style: normal;
  }

  .crimson-text-bold {
    font-family: 'Crimson Text', serif;
    font-weight: 700;
    font-style: normal;
  }

  .crimson-text-regular-italic {
    font-family: 'Crimson Text', serif;
    font-weight: 400;
    font-style: italic;
  }

  .crimson-text-semibold-italic {
    font-family: 'Crimson Text', serif;
    font-weight: 600;
    font-style: italic;
  }

  .crimson-text-bold-italic {
    font-family: 'Crimson Text', serif;
    font-weight: 700;
    font-style: italic;
  }
  .cs-related-ebikes-heading,
.cs-side-heading {
  font-size: 30px !important;
  line-height: 1.2 !important;
  letter-spacing: 0 !important;
  font-weight: 700 !important;
  margin: 0 !important;
}

.cs-related-ebikes-title {
  color: inherit !important;
  font-size: inherit !important;
  line-height: inherit !important;
  text-decoration: none !important;
}

.custom-main-article-section .--swiper-title {
  display: block;
  font-size: 30px !important;
  line-height: 1.2 !important;
  letter-spacing: 0 !important;
  font-weight: 700 !important;
  text-align: center;
  margin: 0 0 28px !important;
}

</style>

{%- liquid
  assign sid = section.id
  assign se_stts = section.settings
  assign se_blocks = section.blocks
  assign stt_layout = se_stts.layout
  assign stt_image_bg = se_stts.image_bg
  if stt_layout == 't4s-se-container'
    assign html_layout = '<div class="t4s-container">__</div></div>' | split: '__'
  elsif stt_layout == 't4s-container-wrap'
    assign html_layout = '<div class="t4s-container">__</div>' | split: '__'
  else
    assign html_layout = '__' | split: '__'
  endif
  assign blog_url = blog.url
  assign article_id = article.id
  assign article_title = article.title
  assign image = article.image
  assign article_tags = article.tags
  assign visible_tags = 'E-Bike Buying Guides|Reviews & Comparisons|Product Guides|Laws Rebates & Insurance|US State Guides|Maintenance & Repairs|Battery & Electrical|Motor & Performance|Safety & Gear|Routes & Trails|Fat Tire & Off-Road|Commuting & Urban Riding|E-Bike Basics|How-To & Tips|Accessories & Customization|Deals & Sales|Seasonal Riding|Sustainability & Trends|Health & Fitness|Family & Teen Riders|Commercial & Utility E-Bikes|X1|X1S|X2|X7|M16|X1S x Bs.zay' | split: '|'
  assign metaArray =

  if comment.status == 'pending'
    assign number_of_comments = article.comments_count | plus: 1
  else
    assign number_of_comments = article.comments_count
  endif
-%}

{% capture arrow %}
  <svg t="1758180804651" class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4485" width="100%" height="100%"><path d="M248.7 21.6c-27.9 27.9-27.9 73.3-0.1 101.2l388.1 388.9-388.1 388.9c-28 27.9-27.8 73.3 0.1 101.2 27.9 28 73.3 28 101.2 0l415.5-415.5c41.2-41.2 41.2-107.9 0-149.1L349.9 21.6c-27.9-27.9-73.3-27.9-101.2 0z m0 0" p-id="4486"></path></svg>
{% endcapture %}

<div
  class="t4s-section-inner t4s_nt_se_{{sid}} {{stt_layout}}{% if stt_image_bg != blank and stt_layout != 't4s-se-container' %} t4s-has-imgbg lazyloadt4s{% endif %}"
  {% if stt_image_bg != blank and stt_layout != 't4s-se-container' %}
    data-bgset="{{ stt_image_bg | image_url: width: 1 }}" data-sizes="auto" data-optimumx="1.5"
  {% endif %}
  {% render 'section_style', se_stts: se_stts -%}
>
  {{- html_layout[0] -}}
  {%- if stt_layout == 't4s-se-container' -%}
    <div
      class="t4s-container-inner{% if stt_image_bg != blank %} t4s-has-imgbg lazyloadt4s{% endif %}"
      {% if stt_image_bg != blank %}
        data-bgset="{{ stt_image_bg | image_url: width: 1 }}" data-sizes="auto" data-optimumx="1.5"
      {% endif %}
    >
  {% endif -%}
  <div class="flex flex-col md:flex-row">
    <div class="t4s-col-item t4s-main-article-page t4s-main-area !order-0 !space-y-8">
      {%- for block in section.blocks -%}
        {%- assign bk_stts = block.settings -%}
        {%- case block.type -%}
          {%- when 'image' -%}
            {% if image == blank %}{% continue %}{% endif -%}
            <div class="cs_main_article">
              <div
                class="t4s-article-image t4s-pr"
                style="max-width:{{ image.width }}px;margin-left:auto;margin-right:auto;"
              >
                {%- comment -%}
                  <img
                    class="lazyloadt4s"
                    data-src="{{ image | image_url: width: 1 }}"
                    data-widths="[100,200,400,600,700,800,900,1000,1200,1400,1600]"
                    data-optimumx="2"
                    data-sizes="auto"
                    src="{% render 'img_svg',w:image.width,h:image.height %}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    alt="{{ image.alt | escape }}"
                  >
                {%- endcomment -%}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 800w, {{ image | image_url: width: 800 }} 1200w"
                  alt="{{ image.alt | escape }}"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  fetchpriority="high"
                >
                <span
                  class="lazyloadt4s-loader is-bg-img"
                  style="background: url({{image | image_url: width: 1}});"
                ></span>
                {%- if bk_stts.cate_des != 'none' -%}
                  {%- assign article_tags = article_tags | join: ';' | split: ';' -%}
                  {%- assign tag_category = article_tags | where: 'category_' | first -%}
                  <div class="t4s-article-cate-{{bk_stts.cate_des}}">
                    {%- if tag_category != blank -%}
                      <a href="{{ blog_url }}/tagged/{{ tag_category | handle }}" class="t4s-article-cate-text">
                        {{- tag_category | remove: 'category_' | strip -}}
                      </a>
                    {%- else -%}
                      <a href="{{ blog_url }}" class="t4s-article-cate-text">{{ blog.title }}</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
              {%- if article.excerpt != blank -%}
                <div class="!text-lg flex-1 !px-[20px] !pt-[20px]" title="Featured Snippet">{{ article.excerpt }}</div>
              {%- endif -%}
            </div>
          {%- when 'title' -%}
            <div class="t4s-article-title">
              {% if bk_stts.show_title_first %}
                <h1 class=" !text-3xl sm:!text-[2.3em]">{{ article_title }}</h1>
              {% endif %}
              {% if bk_stts.show_au or bk_stts.show_dt or bk_stts.show_cm %}
                <ul class="flex flex-col">
                  <li class="flex !space-x-4">
                    {%- if bk_stts.show_au -%}
                      <span class=" !text-sm sm:!text-lg">
                        {{- 'blogs.article.by' | t }}
                        {{ article.author | replace_first: 'ad clnt', 'admin' -}}
                      </span>
                    {%- endif -%}
                    {%- if bk_stts.show_dt -%}
                      <span class=" !text-sm sm:!text-lg">{{ article.created_at | date: '%B %d, %Y' }}</span>
                    {%- endif -%}

                    {%- if bk_stts.show_cm -%}
                      {%- if number_of_comments > 0 -%}
                        {%- assign cm_link = '#comments' -%}
                      {%- else -%}
                        {%- assign cm_link = '#comment_form' -%}
                      {%- endif -%}
                      <div>
                        <a href="{{ article.url }}{{cm_link}}">
                          {{- 'blogs.comments.with_count_2.other' | t: count: number_of_comments -}}
                        </a>
                      </div>
                    {%- endif -%}
                  </li>

                  {% if bk_stts.show_tag and article_tags.size > 0 %}
                    <li class="flex items-center h-full !text-sm sm:!text-lg overflow-x-auto">
                      {% for item in article_tags %}
                        {% assign tag_handle = item | handleize %}
                        <div class=" shrink-0 grow-0">
                          <a
                            class="blog-tag-link"
                            href="{{ blog.url }}/tagged/{{ tag_handle }}"
                          >
                            {{ item }}
                          </a>
                        </div>
                        {% if forloop.index < article_tags.size %}
                          <div class="h-[8px] w-px bg-black !mx-2 shrink-0 grow-0"></div>
                        {% endif %}
                      {% endfor %}
                    </li>
                  {% endif %}
                </ul>
              {% endif %}
              {% unless bk_stts.show_title_first %}
                <h2>{{ article_title }}</h2>
              {% endunless %}
            </div>
          {%- when 'content' -%}
            <div class="t4s-article-content">
              <article
                id="t4s-article-{{article_id}} cs_main_article_con "
                class="article-{{article_id}} cs_article_con title_line"
              >
                {{ article.content }}
              </article>
              {% if article.tags.size > 0 %}
                <div class="flex">
                  <span class="!font-semibold">Tags：</span>
                  <div class="flex items-center flex-wrap">
                    {% for item in article.tags %}
                      {% assign tag_handle = item | handleize %}
                        <div class=" shrink-0 grow-0">
                          <a
                            class="blog-tag-link"
                            href="{{ blog.url }}/tagged/{{ tag_handle }}"
                          >
                            {{ item }}
                          </a>
                        </div>
                      {% if forloop.index < article.tags.size %}
                        <div class="h-[10px] w-px bg-black !mx-3"></div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
            <div>
              {% if article.metafields.custom.expand_btn.value != null %}
                {% assign blog_btn = article.metafields.custom.expand_btn.value %}
              {% else %}
                {% assign blog_btn = se_stts.blog_btn %}
              {% endif %}
              <a class="w-full !block relative" href="{{ blog_btn.lik.value.url }}">
                <div class=" absolute left-0 top-0 w-full h-full !pl-8 md:!pl-16 flex flex-col justify-center">
                  <h4
                    class=" !text-[22px] md:!text-5xl"
                    style="{%  if blog_btn.title_color.value != nil %} color:{{ blog_btn.title_color.value }}; {% else %} color:#ffffff; {% endif %}"
                  >
                    {{ blog_btn.title.value }}
                  </h4>
                  <button
                    class="!font-semibold !px-5 !py-2 !text-base md:!text-lg md:!px-7 md:!py-3 rounded-full !mt-2 md:!mt-5 !block w-fit"
                    style="
                      {%  if blog_btn.lik_txt_color.value != nil %} color:{{ blog_btn.lik_txt_color.value }}; {% else %} color:#000000; {% endif %}
                      {%  if blog_btn.lik_bg_color.value != nil %} background-color:{{ blog_btn.lik_bg_color.value }}; {% else %} background-color:#f2cb04; {% endif %}
                    "
                  >
                    {{ blog_btn.lik.value.text }}
                  </button>
                </div>
                <img
                  class="w-full h-auto"
                  src="{{ blog_btn.img.value |  image_url  }}"
                  alt="{{  blog_btn.img.text }}"
                  width="{{ blog_btn.img.value.width }}"
                  height="{{ blog_btn.img.value.height }}"
                  loading="lazy"
                >
              </a>
            </div>
            <div class="cs_author_about">
              <div class="cs_author_top">
                <div class="cs_author_le">
                  <img
                    src="https://cdn.shopify.com/s/files/1/0714/3581/3182/files/ea8ef2d2-9803-4d3f-b499-079127f8bd7e.png?v=1774494117"
                    width="100%"
                    height="100%"
                    alt=""
                  >
                </div>
                <div class="cs_author_ri">
                  <h3>Meet the Team Behind Macfox</h3>
                  <div class="cs_author_text">
                    The Macfox family is a dynamic, friendly, and welcoming community that shares a common passion.
                    We're not just developing a product, but building a culture around it, and everyone involved with
                    Macfox contributes to this ethos.
                  </div>
                </div>
              </div>
              <div class="cs_author_bt">
                <div class="cs_form_title">
                  <div class="main_title">Join our newsletter.</div>
                  <div class="before_title">Get the latest news about Macfox eBike.</div>
                </div>
                <div class="cs_form">
                  {%- assign form_id = 't4s-form-' | append: form_id -%}
                  {%- form 'customer',
                    class: 't4s-pr t4s-z-100 t4s-newsletter__form',
                    id: form_id,
                    data-form-mail-agree: ''
                  -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="t4s-newsletter__fields ">
                      <div class="t4s-newsletter__inner cs_newsletter__inner t4s-row t4s-g-0 t4s-pr t4s-oh {{class}}">
                        <div class="{{class_email}} t4s-col-item is--col-email">
                          <input
                            type="email"
                            name="contact[email]"
                            placeholder="{{ 'sections.newsletter_form.email_placeholder' | t }}"
                            value="{% if customer %}{{ customer.email }}{% endif %}"
                            class="{{class_ip}} t4s-newsletter__email cs_form_email"
                            required="required"
                          >
                        </div>
                        <div class="{{class_name}} t4s-col-item is--col-name">
                          <input
                            type="text"
                            name="contact[name]"
                            placeholder="Your name"
                            value="{% if customer %}{{ customer.name }}{% endif %}"
                            class="{{class_ip}} t4s-newsletter__name cs_form_name"
                            required="required"
                          >
                        </div>
                        <div class="{{class_btn}} t4s-col-item is--col-btn cs_form_btn">
                          <button
                            data-agreeMail-btn
                            type="submit"
                            class="t4s-w-100 t4s-newsletter__submit t4s-truncate t4s-btn-loading__svg cs_btn_con"
                          >
                            <span class="t4s-newsletter__text">
                              {{- 'sections.newsletter_form.submit' | t -}}
                              {{- btn_icon -}}
                              {{- icon_Html -}}
                            </span>
                            <span class="t4s-loading__spinner t4s-dn">
                              <svg
                                width="16"
                                height="16"
                                aria-hidden="true"
                                focusable="false"
                                role="presentation"
                                class="t4s-svg__spinner"
                                viewBox="0 0 66 66"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <circle class="t4s-path" fill="none" stroke-width="6" cx="33" cy="33" r="30">
                                </circle>
                              </svg>
                            </span>
                          </button>
                        </div>
                      </div>
                      {{- conditions_mail- }}
                    </div>
                    <div data-new-response-form class="t4s-newsletter__response">
                      {%- if form.posted_successfully? -%}
                        <div class="t4s-newsletter__success">
                          <svg
                            width="18"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 448 512"
                          >
                            <path
                                d="M443.3 100.7C449.6 106.9 449.6 117.1 443.3 123.3L171.3 395.3C165.1 401.6 154.9 401.6 148.7 395.3L4.686 251.3C-1.562 245.1-1.562 234.9 4.686 228.7C10.93 222.4 21.06 222.4 27.31 228.7L160 361.4L420.7 100.7C426.9 94.44 437.1 94.44 443.3 100.7H443.3z" />
                          </svg>
                          {{ 'sections.newsletter_form.confirmation' | t }}
                        </div>
                      {%- elsif form.errors -%}
                        <div class="t4s-newsletter__error">{{ form.errors | default_errors }}</div>
                      {%- endif -%}
                    </div>
                  {%- endform -%}
                </div>
              </div>
            </div>
          {%- when 'tags' -%}
            {%- if number_of_comments > 0 -%}
              {%- assign cm_link = '#comments' -%}
            {%- else -%}
              {%- assign cm_link = '#comment_form' -%}
            {%- endif -%}
            {%- if article.tags.size > 0 or blog.comments_enabled? -%}
              <div class="t4s-article-tags">
                <div class="t4s-row t4s-align-items-center t4s-gy-md-0 t4s-gy-20">
                  <div class="t4s-col-item t4s-col-md t4s-col-12 t4s-align-items-center t4s-article-tags-list">
                    {%- if article.tags.size > 0 -%}
                      <div class="t4s-d-flex align-items-center t4s-justify-content-md-start t4s-justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="20">
                          <path d="M80 136C80 122.7 90.75 112 104 112C117.3 112 128 122.7 128 136C128 149.3 117.3 160 104 160C90.75 160 80 149.3 80 136zM204.1 32C216.8 32 229.1 37.06 238.1 46.06L410.7 218.7C435.7 243.7 435.7 284.3 410.7 309.3L277.3 442.7C252.3 467.7 211.7 467.7 186.7 442.7L14.06 270.1C5.057 261.1 0 248.8 0 236.1V80C0 53.49 21.49 32 48 32H204.1zM36.69 247.4L209.4 420.1C221.9 432.6 242.1 432.6 254.6 420.1L388.1 286.6C400.6 274.1 400.6 253.9 388.1 241.4L215.4 68.69C212.4 65.69 208.4 64 204.1 64H48C39.16 64 32 71.16 32 80V236.1C32 240.4 33.69 244.4 36.69 247.4V247.4zM308.4 36.95C314.5 30.56 324.7 30.33 331.1 36.43L472.4 171.5C525.1 221.9 525.1 306.1 472.4 356.5L347.8 475.6C341.4 481.7 331.3 481.4 325.2 475.1C319.1 468.7 319.3 458.5 325.7 452.4L450.3 333.4C489.8 295.6 489.8 232.4 450.3 194.6L308.9 59.57C302.6 53.46 302.3 43.34 308.4 36.95V36.95z"></path>
                        </svg>
                        {% for tag in article.tags %}
                          <a href="{{ blog_url }}/tagged/{{ tag | handle }}" rel="tag">
                            {{- tag | remove: 'category_' | strip -}}
                          </a>
                          {%- unless forloop.last %}, {% endunless -%}
                        {%- endfor %}
                      </div>
                    {%- endif -%}
                  </div>
                  {%- if blog.comments_enabled? -%}
                    <div class="t4s-col-item t4s-col-md-auto t4s-comment-link">
                      <div class="t4s-d-flex align-items-center t4s-justify-content-md-end t4s-justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="20">
                          <path d="M256 31.1c-141.4 0-255.1 93.13-255.1 208c0 47.62 19.91 91.25 52.91 126.3c-14.87 39.5-45.87 72.88-46.37 73.25c-6.623 7-8.373 17.25-4.623 26C5.816 474.3 14.38 480 24 480c61.49 0 109.1-25.75 139.1-46.25c28.1 9 60.16 14.25 92.9 14.25c141.4 0 255.1-93.13 255.1-207.1S397.4 31.1 256 31.1zM256 416c-28.25 0-56.24-4.25-83.24-12.75c-9.516-3.068-19.92-1.461-28.07 4.338c-22.1 16.25-58.54 35.29-102.7 39.66c11.1-15.12 29.75-40.5 40.74-69.63l.1289-.3398c4.283-11.27 1.791-23.1-6.43-32.82C47.51 313.1 32.06 277.6 32.06 240c0-97 100.5-176 223.1-176c123.5 0 223.1 79 223.1 176S379.5 416 256 416zM272 272h-128c-8.801 0-16 7.199-16 15.1C127.1 296.8 135.2 304 144 304h128c8.801 0 15.1-7.204 15.1-16C287.1 279.2 280.8 272 272 272zM368 176h-224c-8.801 0-16 7.199-16 15.1C127.1 200.8 135.2 208 144 208h224c8.801 0 15.1-7.204 15.1-16C383.1 183.2 376.8 176 368 176z"/>
                        </svg>
                        <a href="{{ article.url }}{{cm_link}}">
                          {{- 'blogs.comments.with_count_2.other' | t: count: number_of_comments -}}
                        </a>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- when 'socials' -%}
            {{ 'icon-social.css' | asset_url | stylesheet_tag }}
            <div
              class="t4s-article-social-share t4s-text-center"
              style="--cl:{{bk_stts.icon_cl}};--bg-cl:{{bk_stts.bg_cl}};--bd-radius:{{bk_stts.bd_radius}}px"
            >
              {%- if bk_stts.social_mode == '1' -%}
                {%- assign follow_social = true -%}
              {%- else -%}
                {%- assign share_image = settings.share_image | default: page_image | default: settings.logo -%}
              {%- endif -%}
              {%- render 'social_sharing',
                style: bk_stts.social_style,
                use_color_set: bk_stts.use_color_set,
                size: bk_stts.social_size,
                space_h_item: bk_stts.space_h_item,
                space_h_item_mb: bk_stts.space_h_item_mb,
                space_v_item: bk_stts.space_v_item,
                space_v_item_mb: bk_stts.space_v_item_mb,
                follow_social: follow_social
              -%}
            </div>
          {%- when 'navigation' -%}
            {% liquid
              assign current_index = null

              for a in blog.articles
                if a.id == article.id
                  assign current_index = forloop.index0
                endif
              endfor

              assign prev_article = null
              assign next_article = null

              if current_index != null
                assign prev_index = current_index | minus: 1
                assign next_index = current_index | plus: 1

                if prev_index >= 0
                  assign prev_article = blog.articles[prev_index]
                endif

                if next_index < blog.articles.size
                  assign next_article = blog.articles[next_index]
                endif
              endif

              if prev_article and prev_article.id == article.id
                assign prev_article = null
              endif

              if next_article and next_article.id == article.id
                assign next_article = null
              endif
            %}
            <div class="article-navigation flex justify-center">
              <div class="w-2/5 flex justify-end">
                {%- if prev_article and prev_article.handle != next_article.handle -%}
                  <a
                    href="{{prev_article.url}}"
                    class=" flex items-center h-full overflow-x-auto"
                    data-tooltip="top"
                    title="{{prev_article.title}}"
                  >
                    <svg
                      class=" h-full aspect-square shrink-0 grow-0"
                      xmlns="http://www.w3.org/2000/svg"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                      version="1.1"
                      width="32"
                      height="32"
                      viewBox="0 0 32 32"
                    >
                      <path d="M12.792 15.233l-0.754 0.754 6.035 6.035 0.754-0.754-5.281-5.281 5.256-5.256-0.754-0.754-3.013 3.013z"/>
                    </svg>
                    <span class="!text-lg !text-right !text-nowrap overflow-hidden text-ellipsis">
                      {{- prev_article.title -}}
                    </span>
                  </a>
                {% endif -%}
              </div>

              <a
                href="{{blog_url}}"
                class="current-blog !mx-5"
                data-tooltip="top"
                title="{{'blogs.article.back_to' | t:title:blog.title}}"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                  version="1.1"
                  width="32"
                  height="32"
                  viewBox="0 0 32 32"
                >
                  <path d="M6.937 21.865c-1.766 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM6.937 27.195c-1.176 0-2.132-0.956-2.132-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                  <path d="M6.937 3.738c-1.766 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM6.937 9.069c-1.176 0-2.132-0.956-2.132-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                  <path d="M6.937 12.779c-1.766 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM6.937 18.11c-1.176 0-2.132-0.957-2.132-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                  <path d="M16 21.865c-1.767 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM16 27.195c-1.176 0-2.133-0.956-2.133-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                  <path d="M16 3.738c-1.767 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM16 9.069c-1.176 0-2.133-0.956-2.133-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                  <path d="M16 12.779c-1.767 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM16 18.11c-1.176 0-2.133-0.957-2.133-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                  <path d="M25.063 21.865c-1.767 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM25.063 27.195c-1.176 0-2.133-0.956-2.133-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                  <path d="M25.063 10.135c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198c-1.767 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199zM25.063 4.805c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133c-1.176 0-2.133-0.956-2.133-2.133s0.956-2.132 2.133-2.132z" fill="currentColor"/>
                  <path d="M25.063 12.779c-1.767 0-3.199 1.432-3.199 3.198s1.432 3.199 3.199 3.199c1.766 0 3.199-1.432 3.199-3.199s-1.433-3.198-3.199-3.198zM25.063 18.11c-1.176 0-2.133-0.957-2.133-2.133s0.956-2.132 2.133-2.132c1.176 0 2.133 0.956 2.133 2.132s-0.956 2.133-2.133 2.133z" fill="currentColor"/>
                </svg>
              </a>

              <div class="w-2/5">
                {%- if next_article -%}
                  <a
                    href="{{next_article.url}}"
                    class="flex items-center"
                    data-tooltip="top"
                    title="{{next_article.title}}"
                  >
                    <span class="!text-lg !text-left !text-nowrap overflow-hidden text-ellipsis">
                      {{- next_article.title -}}
                    </span>
                    <svg
                      class="h-full aspect-square shrink-0 grow-0"
                      xmlns="http://www.w3.org/2000/svg"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                      version="1.1"
                      width="32"
                      height="32"
                      viewBox="0 0 32 32"
                    >
                      <path d="M19.159 16.767l0.754-0.754-6.035-6.035-0.754 0.754 5.281 5.281-5.256 5.256 0.754 0.754 3.013-3.013z"/>
                    </svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- when 'related' -%}
            {%- liquid
              assign num = bk_stts.article_nums
            -%}
            {% if article.metafields.custom.recommend_articles.value != null %}
              <div class="--swiper-title">Related Articles</div>
              <div class="related-article-box swiper">
                <div class="--left-btn --swiper-btn">
                  {{ arrow }}
                </div>
                <div class="swiper-wrapper">
                  {% if article.metafields.custom.recommend_articles.value != null %}
                    {% if block.settings.pin_article != null %}
                      {%- assign pin_article = block.settings.pin_article -%}
                      <div class="swiper-slide">
                        <a
                          href="{{ pin_article.url }}"
                          target="_blank"
                        >
                          <div class="--swiper-info">
                            {%- if pin_article.image -%}
                              <img
                                src="{{ pin_article.image | image_url }}"
                                width="100%"
                                height="auto"
                                alt="{{ pin_article.title }}"
                              >
                            {%- endif -%}
                            <p>
                              <strong>{{ pin_article.title }}</strong>
                            </p>
                          </div>
                          <time
                            datetime="{{ pin_article.published_at | date: '%B %d, %Y' }}"
                          >
                            {{- pin_article.published_at | date: '%B %d, %Y' -}}
                          </time>
                        </a>
                      </div>
                    {% endif %}
                    {%- for i in article.metafields.custom.recommend_articles.value -%}
                      <div class="swiper-slide">
                        <a
                          href="{{ i.url }}"
                          target="_blank"
                        >
                          <div class="--swiper-info">
                            <img
                              src="{{ i.image |  image_url }}"
                              width="{{ i.image.width }}"
                              height="{{ i.image.height }}"
                              alt="{{ i.title }}"
                            >
                            <p class=" !text-lg md:!text-xl text-center !mt-3">
                              <strong>{{ i.title }}</strong>
                            </p>
                          </div>
                          <time
                            datetime="{{ i.published_at | date: '%B %d, %Y' }}"
                          >
                            {{- i.published_at | date: '%B %d, %Y' -}}
                          </time>
                        </a>
                      </div>
                    {%- endfor -%}
                  {% else %}
                    {%- for i in (1..num) -%}
                      {%- assign key = 'article_' | append: i -%}
                      {%- assign art_mc = article.metafields.custom[key] -%}
                      {%- assign value = 'news/' | append: art_mc -%}
                      {% assign related_article = articles[value] %}
                      {%- if art_mc != blank and related_article != blank -%}
                        <div class="swiper-slide">
                          <a
                            href="{{ related_article.url }}"
                            target="_blank"
                          >
                            <div class="--swiper-info">
                              <img
                                src="{{ related_article.image |  image_url }}"
                                width="{{ related_article.image.width }}"
                                height="{{ related_article.image.height }}"
                                alt="{{ related_article.title }}"
                              >
                              <p>
                                <strong>{{ related_article.title }}</strong>
                              </p>
                            </div>
                            <time
                              datetime="{{ related_article.published_at | date: '%B %d, %Y' }}"
                            >
                              {{- related_article.published_at | date: '%B %d, %Y' -}}
                            </time>
                          </a>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  {% endif %}
                </div>
                <div class="swiper-pagination"></div>
                <div class="--right-btn --swiper-btn">
                  {{ arrow }}
                </div>
              </div>
            {% endif %}
          {%- when 'latest' -%}
            <div class="--swiper-title">{{ bk_stts.hd_latest | default: 'Latest Articles' }}</div>
            <div class="latest-article-box swiper">
              <div class="--left-btn --swiper-btn">
                {{ arrow }}
              </div>
              <div class="swiper-wrapper">
                {% if block.settings.pin_article != null %}
                  {%- assign pin_article = block.settings.pin_article -%}
                  <div class="swiper-slide">
                    <a
                      class=" w-[93%] md:w-[95%] !mx-auto flex flex-col h-full"
                      href="{{ pin_article.url }}"
                      target="_blank"
                    >
                      <div class="flex-1">
                        {%- if pin_article.image -%}
                          <img
                            class="aspect-[3/2] object-cover"
                            src="{{ pin_article.image | image_url }}"
                            width="100%"
                            height="auto"
                            alt="{{ pin_article.title }}"
                          >
                        {%- endif -%}
                        <p class=" !text-lg md:!text-xl text-center !mt-3">
                          <strong>{{ pin_article.title }}</strong>
                        </p>
                      </div>
                      <time
                        class="!italic !text-lg text-center"
                        datetime="{{ pin_article.published_at | date: '%B %d, %Y' }}"
                      >
                        {{- pin_article.published_at | date: '%B %d, %Y' -}}
                      </time>
                    </a>
                  </div>
                {% endif %}
                {%- for item in blog.articles -%}
                  {% if forloop.index > bk_stts.article_nums %}
                    {% break %}
                  {% endif %}

                  <div class="swiper-slide">
                    <a
                      href="{{ item.url }}"
                      target="_blank"
                    >
                      <div class="--swiper-info">
                        {%- if item.image -%}
                          <img
                            src="{{ item.image | image_url }}"
                            width="100%"
                            height="auto"
                            alt="{{ item.title }}"
                          >
                        {%- endif -%}
                        <p>
                          <strong>{{ item.title }}</strong>
                        </p>
                      </div>
                      <time
                        datetime="{{ item.published_at | date: '%B %d, %Y' }}"
                      >
                        {{- item.published_at | date: '%B %d, %Y' -}}
                      </time>
                    </a>
                  </div>
                {%- endfor -%}
              </div>
              <div class="swiper-pagination"></div>
              <div class="--right-btn --swiper-btn">
                {{ arrow }}
              </div>
            </div>
            <div class="article-all-tags block md:hidden !mt-8">
              <div class="--swiper-title">Content Tags</div>
              <div class="blog_menu_tag">
                {% for tag in visible_tags %}
                  {% if blog.all_tags contains tag %}
                    <a href="{{ blog_url }}/tagged/{{ tag | handle }}" class="t4s-post-text-color">
                      {{ tag }}
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

          {%- when 'html' -%}
            <div class="t4s-article-html">{{ bk_stts.html }}</div>

          {%- when 'author' -%}
            {%- liquid
              assign bk_stts.au_image = image
            -%}
            <div class="t4s-article-author">
              <div class="t4s-row t4s-align-items-center t4s-gx-15 t4s-gx-md-15 t4s-gx-md-15">
                <div class="t4s-col-item t4s-pr" style="max-width:100px;">
                  {%- if bk_stts.au_image != blank -%}
                    <img
                      class="lazyloadt4s"
                      data-src="{{ image | image_url: width: 1 }}"
                      data-widths="[100,200,400,600,700,800,900,1000,1200,1400,1600]"
                      data-optimumx="2"
                      data-sizes="auto"
                      src="{% render 'img_svg',w:image.width,h:image.height %}"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      alt="{{ image.alt | escape }}"
                    >
                    <span
                      class="lazyloadt4s-loader is-bg-img"
                      style="background: url({{image | image_url: width: 1}});"
                    ></span>
                  {%- endif -%}
                </div>
                <div class="t4s-col-item" style="width: auto;">
                  {%- if bk_stts.au_title != blank -%}
                    <h4>{{ bk_stts.au_title }}</h4>
                  {%- else -%}
                    <h4>{{ article.author | replace_first: 'ad clnt', '' }}</h4>
                  {%- endif -%}
                  <span>{{ bk_stts.au_text }}</span>
                </div>
              </div>
            </div>

          {%- when '@app' -%}
            <div class="t4s-page-block--app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <aside class="cs-article-aside md:!pl-4 md:!mt-0 !mt-16">
      {% if article.metafields.custom.products.value != blank %}
        <div>
          {% assign re_roducts = article.metafields.custom.products.value %}
          <div class="cs-related-ebikes-heading">
  <a href="/collections/electric-bike" class="cs-related-ebikes-title">Related E-Bikes</a>
</div>
          <div class=" h-2 w-[20%] !mb-5 bg-gray-800"></div>
          <div class="!space-y-5">
            {% for item in re_roducts %}
              <a
                class="flex flex-col items-center hover:shadow-[0_0_8px_#ebebeb] transition-all rounded-xl overflow-hidden !px-4 !pb-6"
                href="{{ item.url }}"
                target="_blank"
              >
                <img
                  src="{{ item.featured_image |  image_url: width:350  }}"
                  width="{{ item.featured_image.width }}"
                  height="{{ item.featured_image.height }}"
                  alt="{{ item.title }}"
                >
                <p>
                  <strong>{{ item.title }}</strong>
                </p>
                <div class="flex items-center">
                  {% if item.price_max != blank %}
                    <span>{{ item.price_min | money_with_currency }}</span> -
                    <span>{{ item.price_max | money_with_currency }}</span>
                  {% else %}
                    <span>{{ item.price | money_with_currency }}</span>
                  {% endif %}
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
      <div class="article-all-tags hidden md:block !mt-8">
       <div class="cs-side-heading">Content Tags</div>
        <div class="h-2 w-[20%] !mb-5 bg-gray-800"></div>
        <div class="blog_menu_tag">
          {% for tag in visible_tags %}
            {% if blog.all_tags contains tag %}
              <a href="{{ blog_url }}/tagged/{{ tag | handle }}" class="t4s-post-text-color">
                {{ tag }}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </aside>
  </div>

  <div class="md:w-[75%]">
    {%- for block in section.blocks -%}
      {%- assign bk_stts = block.settings -%}
      {%- case block.type -%}
        {%- when 'comments' -%}
          {% unless article.comments_enabled? %}{% continue %}{% endunless -%}
          <div class="t4s-article-comments-block">
            {%- if number_of_comments > 0 -%}
              {%- assign anchorId = '#Comments-' | append: article.id -%}
              <div class="t4s-line-space"></div>
              {%- paginate article.comments by 5 -%}
                {%- comment -%}
                  #comments is required, it is used as an anchor link by Shopify.
                {%- endcomment -%}
                <div id="comments">
                  <h2 id="Comments-{{ article.id }}" class="t4s-comments-heading">
                    {{ 'blogs.comments.comments_title_html' | t: count: number_of_comments, title: article_title }}
                  </h2>
                  <div class="t4s-row t4s-row-cols-1 t4s-gy-30">
                    {%- if comment.status == 'pending' and comment.content -%}
                      {%- comment -%}
                        If a comment was just submitted with no blank field, show it.
                      {%- endcomment -%}
                      <div id="{{ comment.id }}" class="t4s-comment-item comment t4s-col-item">
                        {%- render 'comment', comment: comment -%}
                      </div>
                    {%- endif -%}
                    {%- for comment in article.comments -%}
                      <div id="{{ comment.id }}" class="t4s-comment-item t4s-col-item">
                        {%- render 'comment', comment: comment -%}
                      </div>
                    {%- endfor -%}
                    {%- if paginate.pages > 1 -%}
                      <div class="t4s-col-12">
                        {%- render 'pagination', paginate: paginate, anchor: anchorId, ajax: 'false' -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endpaginate -%}
            {%- endif -%}
            <div class="t4s-line-space"></div>
            {%- form 'new_comment', article, id: 'CommentForm' -%}
              <h2 class="t4s-comments-form__heading">{{ 'blogs.comments.title' | t }}</h2>
              <p class="t4s-comments-form__notes">{{ 'blogs.comments.comments_note_html' | t }}</p>
              {%- liquid
                assign post_message = 'blogs.comments.success'
                assign blog_moderate = blog.moderated?
                if blog.moderated? and comment.status == 'pending'
                  assign post_message = 'blogs.comments.success_moderated'
                elsif comment.status == 'unapproved' or comment.status == 'spam'
                  assign post_message = 'blogs.comments.unapproved'
                endif
                assign error_heading = 'blogs.comments.error_heading'
                assign name = 'blogs.comments.name'
                assign email = 'blogs.comments.email'
                assign message = 'blogs.comments.message'
                assign form_errors = form.errors
                assign form_errors_messages = form_errors.messages

                render 'form-status', form: form, form_id: 'CommentForm', success_message: post_message, form_errors: form_errors, form_errors_messages: form_errors_messages, error_heading: error_heading, name: name, email: email, message: message
              -%}
              <div class="t4s-row">
                <div class="t4s-col-md-6 t4s-col-item t4s-form-group">
                  <label class="t4s-field__label" for="CommentForm-author">
                    {{- name | t }}
                    <span aria-hidden="true">*</span></label
                  >
                  <input
                    type="text"
                    name="comment[author]"
                    id="CommentForm-author"
                    class="t4s-field__input {% if form_errors contains 'author' %}t4s-input--error{% endif %}"
                    autocomplete="name"
                    value="{{ form.author }}"
                    aria-required="true"
                    {% if form_errors contains 'author' %}
                      aria-invalid="true" aria-describedby="CommentForm-author-error"
                    {% endif %}
                    placeholder=""
                  >
                  {%- if form_errors contains 'author' -%}
                    <small id="CommentForm-author-error"
                      ><span class="t4s-message-error">
                        {%- render 'icon-error' -%}
                        {{- name | t }}
                        <span>{{ form_errors_messages.author }}.</span></span
                      ></small
                    >
                  {%- endif -%}
                </div>
                <div class="t4s-col-md-6 t4s-col-item t4s-form-group">
                  <label class="t4s-field__label" for="CommentForm-email">
                    {{- email | t }}
                    <span aria-hidden="true">*</span></label
                  >
                  <input
                    type="email"
                    name="comment[email]"
                    id="CommentForm-email"
                    autocomplete="email"
                    class="t4s-field__input {% if form_errors contains 'email' %} t4s-input--error{% endif %}"
                    value="{{ form.email }}"
                    autocorrect="off"
                    autocapitalize="off"
                    aria-required="true"
                    {% if form_errors contains 'email' %}
                      aria-invalid="true" aria-describedby="CommentForm-email-error"
                    {% endif %}
                    placeholder=""
                  >
                  {%- if form_errors contains 'email' -%}
                    <small id="CommentForm-email-error"
                      ><span class="t4s-message-error">
                        {%- render 'icon-error' -%}
                        {{- email | t }}
                        {{ form_errors_messages.email }}.</span
                      ></small
                    >
                  {%- endif -%}
                </div>
                <div class="t4s-col-item t4s-form-group">
                  <label class="t4s-form__label t4s-field__label" for="CommentForm-body">
                    {{- message | t }}
                    <span aria-hidden="true">*</span></label
                  >
                  <textarea
                    rows="5"
                    name="comment[body]"
                    id="CommentForm-body"
                    class="text-area t4s-field__input {% if form_errors contains 'body' %} t4s-input--error{% endif %}"
                    aria-required="true"
                    {% if form_errors contains 'body' %}
                      aria-invalid="true" aria-describedby="CommentForm-body-error"
                    {% endif %}
                    placeholder=""
                  >{{ form.body }}</textarea>
                  {%- if form_errors contains 'body' -%}
                    <small id="CommentForm-body-error"
                      ><span class="t4s-message-error">
                        {%- render 'icon-error' -%}
                        {{- message | t }}
                        {{ form_errors_messages.body }}.</span
                      ></small
                    >
                  {%- endif -%}
                </div>
              </div>
              {%- if blog_moderate -%}
                <p class="t4s-article-template__comment-warning t4s-fnt-fm-3">{{ 'blogs.comments.moderated' | t }}</p>
              {%- endif -%}
              <input
                type="submit"
                class="t4s-btn t4s-btn-base t4s-btn-style-{{bk_stts.button_style}} t4s-btn-size-{{bk_stts.btn_size}} t4s-btn-color-{{bk_stts.btn_cl}}{% if bk_stts.enable_full_btn %} t4s-w-100 t4s-justify-content-center{% endif %} t4s-btn-effect-fade t4s-cursor-pointer"
                value="{{ 'blogs.comments.post' | t }}"
              >
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  {{- html_layout[0] -}}
</div>
<style>
  .t4s-article-title ul li {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    flex-grow: 0;
  }

  .t4s-article-image {
    width: 60%;
  }
  .t4s-article-image .t4s-article-cate-defautl .t4s-article-cate-text {
    margin-top: 20px;
    color: var(--accent-color);
    display: block;
