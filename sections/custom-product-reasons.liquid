  "name": "Custom Product Reasons",
  "tag": "section",
  "class": "cs-product-reasons-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Three Reasons to Join the MACFOX Squad"
    },
    {
      "type": "text",
      "id": "desc",
      "label": "描述",
      "default": "Why thousands of riders and parents are choosing the MACFOX life."
    }
  ],
  "blocks": [
  {
    "type": "card_item",
    "name": "卡片",
    "settings": [
      {
        "type": "html",
        "label": "图标",
        "id": "icon",
        "info": "图标填SVG代码"
      },
      {
        "type": "text",
        "id": "title",
        "default": "UL Certified Safety",
        "label": "标题"
      },
      {
        "type": "text",
        "id": "desc",
        "default": "UL 2849 certified for total battery and system safety. As one of the industry's strictest standards, MACFOX is quality you can trust",
        "label": "描述"
      }
    ]
  }
