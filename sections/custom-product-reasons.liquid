{% liquid
  assign se_stts = section.settings
  assign se_blocks = section.blocks
%}

<div class="cs-product-reasons-wrapper">
  <p class="--reasons-title">{{ se_stts.title }}</p>
  <p class="--reasons-desc">{{ se_stts.desc }}</p>
  <div class="--reasons-content">
    {%- for block in se_blocks -%}
      {%- case block.type -%}
        {%- when 'card_item' -%}
          <div class="--card-item">
            <div class="--item-icon">{{ block.settings.icon }}</div>
            <p class="--item-title">{{ block.settings.title }}</p>
            <p class="--item-desc">{{ block.settings.desc }}</p>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

