          "type": "image_picker",
          "id": "logo_image",
          "label": "Media logo"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Logo alt text"
        },
        {
          "type": "text",
          "id": "review_type",
          "label": "Review type",
          "default": "EXPERT REVIEW"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Short excerpt",
          "default": "Autoevolution rode the Macfox X7L and covered its scrambler-style frame, build quality, wheelset, braking, power, and real-world range notes."
        },
        {
          "type": "url",
          "id": "article_url",
          "label": "Article URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Reviews Demo",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "source_name": "electrek",
            "review_type": "EXPERT REVIEW",
            "excerpt": "Electrek reviewed the Macfox X7 as a street-legal, UL-listed e-bike with moped-style presence and everyday ride practicality."
          }
        },
        {
          "type": "review",
          "settings": {
            "source_name": "autoevolution",
            "review_type": "EXPERT REVIEW",
            "excerpt": "Autoevolution rode the Macfox X7L and covered its scrambler-style frame, build quality, wheelset, braking, power, and real-world range notes."
          }
        },
        {
          "type": "review",
          "settings": {
            "source_name": "CleanTechnica",
            "review_type": "MEDIA COVERAGE",
            "excerpt": "Coverage focused on Macfox e-bike value, commuter use, and how the model fits riders looking for practical electric mobility."
          }
        }
      ]
    }
  ]
}
{% endschema %}