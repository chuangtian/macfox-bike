{% liquid
  assign sid = section.id
  assign se_stts = section.settings
  assign se_blocks = section.blocks
%}

<style>
    .cs-product-show {
        position: relative;
        font-family: Antonio;
        width: 100%;
        height: 62.9rem;
        background: url(https://cdn.shopify.com/s/files/1/0714/3581/3182/files/11_2x-100.webp?v=1730684221) no-repeat center / cover;
        overflow: hidden;
        z-index: 0;
    }
    .cs-product-show::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100px;
        background: linear-gradient(0deg, rgba(0, 0, 0, 0.1) 0%, #000000 100%);
        z-index: -1;
    }
    .cs-product-show::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 100px;
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, #000000 100%);
        z-index: -1;
    }
    .cs-product-show .product-show-con {
        display: flex;
        justify-content: start;
        height: 100%;
    }
    .cs-product-show .product-image {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50vw;
        height: 100%;
        transform: translateX(100%);
        transition: all 1s ease;
    }
    .cs-product-show .product-image img {
        display: block;
        width: 80%;
        height: 80%;
        object-fit: contain;
    }
    .cs-product-show .product-info {
        flex: 0 0 40%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: start;
        text-align: left;
    }
    .cs-product-show .product-title {
        max-width: 410px;
        color: #f2cb04;
        font-weight: 700;
        line-height: 1.2;
        font-size: 7.1rem;
        font-family: Antonio;
    }
    .cs-product-show .product-desc {
        margin: 25px 0;
        font-size: 1.3rem;
        font-weight: 400;
        line-height: 1.5;
        font-family: Poppins;
        color: var(--text-main-color);
    }
    .cs-product-show .product-feature-list {
        display: flex;
        align-items: center;
        margin-bottom: 5.7rem;
        color: #f2cb04;
        font-size: 2.1rem;
        font-weight: 700;
        line-height: 1.2;
        font-family: Antonio;
    }
    .cs-product-show .product-feature-line {
        margin: 0 15px;
        width: 2px;
        height: 90%;
        background-color: #f2cb04;
    }
    .cs-product-show .product-link-btn {
        padding: 1.3rem 3.6rem;
        border: 1px solid var(--text-main-color);
        color: #fff;
        line-height: 1;
        font-weight: 500;
        font-size: 1.3rem;
        text-align: center;
        font-family: Poppins;
    }
    @media screen and (max-width: 768px) {
        .cs-product-show {
            padding-top: 20px;
            height: 750px;
            background: url(https://cdn.shopify.com/s/files/1/0714/3581/3182/files/11_2x-100.webp?v=1730684221) no-repeat center / cover;
        }
        .cs-product-show .product-image {
            top: auto;
            bottom: 0;
            width: 100%;
            height: 50%;
        }
        .cs-product-show .product-image img {
            width: 100%;
            height: 90%;
        }
        .cs-product-show .product-info {
            flex: 0 0 auto;
            align-items: center;
            width: 100%;
            height: 50%;
            text-align: center;
        }
        .cs-product-show .product-title {
            width: 100%;
            max-width: 100%;
            font-size: 30px;
        }
        .cs-product-show .product-desc {
            font-size: 14px;
        }
        .cs-product-show .product-feature-list {
            font-size: 20px;
            justify-content: center;
            margin-bottom: 4.5rem;
        }
    }
</style>

<div class="cs-product-show">
    <div class="product-show-con cs-page-width">
        <div class="product-info">
            <h2 class="product-title">{{ se_stts.title }}</h2>
            <div class="product-desc">{{ se_stts.desc }}</div>
            <div class="product-feature-list">
                {%- for block in se_blocks -%}
                    <div class="product-feature-item">{{ block.settings.text }}</div>
                    {%- unless forloop.last -%}
                        <div class="product-feature-line"></div>
                    {%- endunless -%}
                {%- endfor -%}
            </div>
            <a href="{{ se_stts.product.url }}?variant={{ se_stts.pro_id }}" class="product-link-btn">SHOP NOW</a>
        </div>
        <a href="{{ se_stts.product.url }}?variant={{ se_stts.pro_id }}" class="product-image">
            <img src="{{ se_stts.pro_img | image_url: width: 800 }}" alt="{{ se_stts.pro_img.alt | escape }}" width="100%" height="auto" loading="lazy">
        </a>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        $(window).on('load', function(){
            $('.cs-product-show').each(function(){
                let $this = $(this);
                let triggerPoint = $this.offset().top / 3;
                if ($(window).scrollTop() >= triggerPoint) {
                    $this.find('.product-image').css('transform', 'translateX(0)');
                }
                $(window).on('scroll', function () {
                    if ($(window).scrollTop() >= triggerPoint) {
                        $this.find('.product-image').css('transform', 'translateX(0)');
                    }
                });
            })
        })
    })
</script>

{% schema %}
{
    "name": "Custom Product Show",
    "tag": "section",
    "settings": [
        {
            "type": "textarea",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "textarea",
            "id": "desc",
            "label": "Description"
        },
        {
            "type": "product",
            "id": "product",
            "label": "Product"
        },
        {
            "type": "number",
            "id": "pro_id",
            "label": "Product ID"
        },
        {
            "type": "image_picker",
            "id": "pro_img",
            "label": "Product Image"
        }
    ],
    "blocks": [
        {
            "type": "feature",
            "name": "Feature",
            "settings": [
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Custom Product Show"
        }
    ]
}
{% endschema %}