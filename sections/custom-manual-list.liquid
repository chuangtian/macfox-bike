{% liquid
  assign sid = section.id
  assign se_stts = section.settings
  assign se_blocks = section.blocks
  assign manual_data = metaobjects.instruction_manual.values
  assign lan_options = 'All'
  assign product_options = "All"
  for manual in manual_data
    assign product_options = product_options | append: ',' | append: manual.product.value.title
    assign lan_options = lan_options | append: ',' | append: manual.language.value
  endfor
  assign product_options = product_options | split: ',' | uniq
  assign lan_options = lan_options | split: ',' | uniq
%}

<style>
  #shopify-section-{{ sid }} {
    width: 100%;
    background: #000;
  }
  .cs-manual-list {
    margin: 0 auto;
    padding: 8vh 0;
    min-height: 70vh;
    width: 90vw;
    overflow: hidden;
  } 
  .cs-manual-list .manual-list-heading {
    margin-bottom: 5vh;
    color: #fff;
    font-size: 3vw;
    line-height: 1.5;
    font-weight: 700;
  }
  .cs-manual-list .manual-grid-con {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1vw;
  }
  .cs-manual-list .manual-grid-item {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5vw;
    padding: 3vw 0 2.5vw;
    border: 1px solid #444;
    border-radius: 10px;
  }
  .cs-manual-list .manual-item-link {
    display: block;
    width: 60%;
  }
  .cs-manual-list .manual-item-download {
    position: absolute;
    top: 1vw;
    right: 1vw;
    display: block;
    width: 1.5vw;
    height: auto;
  }
  .cs-manual-list .manual-item-link img, 
  .cs-manual-list .manual-item-download img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cs-manual-list .manual-item-name {
    margin: 0;
    width: 80%;
    color: #fff;
    font-size: .9vw;
    line-height: 1.5;
    text-align: center;
    word-break: break-word;
  }
  .cs-manual-list .manual-filter-con {
    display: flex;
    flex-wrap: wrap;
    gap: 1vw;
    margin: 0 auto 5vh;
  }
  .cs-manual-list .filter-select {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1vw;
    padding: 1vw 1.5vw;
    border: 1px solid #fff;
    border-radius: 8px;
    cursor: pointer;
    z-index: 10;
  }
  .cs-manual-list .filter-select .filter-select-value {
    padding: 0;
    width: 8vw;
    border: none;
    background: none;
    color: #fff;
    font-size: 1.2vw;
    font-weight: 400;
    line-height: 1.5;
    cursor: pointer;
  }
  .cs-manual-list .filter-select .filter-down-arrow {
    display: block;
    width: auto;
    height: 1.2vw;
    color: #fff;
    transition: transform .3s ease;
  }
  .cs-manual-list .filter-select.show  .filter-down-arrow {
    transform: rotate(-180deg);
  }
  .cs-manual-list .product-filter.filter-select .filter-select-value {
    width: 24vw;
  }
  .cs-manual-list .filter-select ul.filter-options {
    position: absolute;
    top: calc(100% + 1px);
    left: -1px;
    right: -1px;
    margin: 0;
    padding: 0;
    max-height: 40vh;
    background: #000;
    border: 1px solid #fff;
    border-radius: 5px;
    opacity: 0;
    visibility: hidden;
    scrollbar-width: thin;
    overflow: auto;
  }
  .cs-manual-list .filter-select.show ul.filter-options {
    opacity: 1;
    visibility: visible;
  }
  .cs-manual-list .filter-select li.filter-option-item {
    padding: .8vw 1.5vw;
    color: #fff;
    font-size: 1.1vw;
    line-height: 1.3;
    cursor: pointer;
  }
  .cs-manual-list .filter-select li.filter-option-item:nth-child(1) {
    padding-top: 1.6vw;
  }
  .cs-manual-list .filter-select li.filter-option-item:nth-last-child(1) {
    padding-bottom: 1.6vw;
  }
  .cs-manual-list .filter-select li.filter-option-item.seleted {
    color: #f2cb04;
  }
  .cs-manual-list .filter-select li.filter-option-item:hover {
    color: #f2cb04 !important;
  }
  @media screen and (max-width: 768px){
    .cs-manual-list {
      padding: 5vh 15px;
      width: 100%;
    }
    .cs-manual-list .manual-list-heading {
      margin-bottom: 30px;
      font-size: 30px;
      text-align: center;
    }
    .cs-manual-list .manual-filter-con {
      gap: 15px;
      margin-bottom: 30px;
    }
    .cs-manual-list .filter-select {
      flex: 1;
      gap: 10px;
      padding: 15px;
    }
    .cs-manual-list .filter-select .filter-select-value {
      flex: 1;
      font-size: 16px;
    }
    .cs-manual-list .filter-select .filter-down-arrow {
      height: 16px;
    }
    .cs-manual-list .filter-select li.filter-option-item {
      padding: 10px 15px;
      font-size: 16px;
    }
    .cs-manual-list .filter-select li.filter-option-item:nth-child(1) {
      padding-top: 20px;
    }
    .cs-manual-list .filter-select li.filter-option-item:nth-last-child(1) {
      padding-bottom: 20px;
    }
    .cs-manual-list .manual-grid-con {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
    .cs-manual-list .manual-grid-item {
      gap: 20px;
      padding: 45px 0 20px;
    }
    .cs-manual-list .manual-item-link {
      width: 50%;
    }
    .cs-manual-list .manual-item-name {
      font-size: 14px;
    }
    .cs-manual-list .manual-item-download {
      top: 15px;
      right: 15px;
      width: 24px;
    }
  }
</style>

<div class="cs-manual-list">
  <h1 class="manual-list-heading">{{ se_stts.heading }}</h1>
  <div class="manual-filter-con">
    {%- for block in se_blocks -%}
      {% case block.type %}
      {% when 'product_filter' %}
        <div class="product-filter filter-select" data-type="product">
          <input class="filter-select-value" type="text" value="" readonly/>
          <svg class="filter-down-arrow" width="10" height="10" role="presentation" viewBox="0 0 19 12"><use xlink:href="#t4s-select-arrow"></use></svg>
          <ul class="filter-options">
            {%- for product in product_options -%}
              <li class="filter-option-item{% if forloop.first %} seleted{% endif %}" 
                data-value="{{ product | handleize }}"
              >{{ product }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {% when 'lan_filter' %}
        <div class="language-filter filter-select" data-type="language">
          <input class="filter-select-value" type="text" value="" readonly/>
          <svg class="filter-down-arrow" width="10" height="10" role="presentation" viewBox="0 0 19 12"><use xlink:href="#t4s-select-arrow"></use></svg>
          <ul class="filter-options">
            {%- for lan in lan_options -%}
              <li class="filter-option-item{% if forloop.first %} seleted{% endif %}" 
                data-value="{{ lan | handleize }}"
              >{{ lan }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {% endcase %}
    {%- endfor -%}
  </div>
  <div class="manual-grid-con">
    {% for manual in manual_data %}
      <div class="manual-grid-item" data-product="{{ manual.product.value.title | handleize }}" data-language="{{ manual.language.value | handleize }}">
        <a class="manual-item-link" href="{{ manual.file | file_url }}" target="_blank">
          <img src="{{ se_stts.pdf_logo | image_url: width: 300 }}" alt="{{ se_stts.pdf_logo.alt }}" width="{{ se_stts.pdf_logo.width }}" height="{{ se_stts.pdf_logo.height }}" loading="lazy">
        </a>
        <p class="manual-item-name">{{ manual.name.value }}</p>
        <a class="manual-item-download" href="{{ manual.file | file_url }}" download>
          <img src="{{ se_stts.download_logo | image_url: width: 80 }}" alt="{{ se_stts.download_logo.alt }}" width="{{ se_stts.download_logo.width }}" height="{{ se_stts.download_logo.height }}" loading="lazy">
        </a>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const $manualItems = $('.cs-manual-list .manual-grid-item');
    let selectedValues = {};
    $('.filter-select').each(function(){
      const $this = $(this);
      const type = $this.data('type');
      const $input = $this.find('.filter-select-value');
      const $optionItems = $this.find('.filter-option-item');

      let $selectedItem = $this.find('.filter-option-item.seleted');
      $input.val($selectedItem.text());
      selectedValues[type] = $selectedItem.data('value');
      
      $this.on('click', function(){
        $this.toggleClass('show');
      })
      $optionItems.on('click', function(){
        let value = $(this).data('value');
        if(value != selectedValues[type]){
          selectedValues[type] = value;
          $input.val($(this).text());
          $(this).addClass('seleted').siblings().removeClass('seleted');
          onSearch();
        }
      })
    })
    onSearch();

    function onSearch(){
      $manualItems.each(function(){
        let $this = $(this);
        let isConform = true;
        for(let type in selectedValues){
          if(selectedValues[type] != 'all' && selectedValues[type] != $this.data(type)){
            isConform = false;
          }
        }
        isConform ? $this.show() : $this.hide();
      })
    }
  })
</script>

{% schema %}
  {
    "name": "Custom Manual List",
    "settings": [
      {
        "type": "header",
        "content": "+ Heading Settings"
      },
      {
        "type": "textarea",
        "id": "heading",
        "label": "Text"
      },
      {
        "type": "image_picker",
        "id": "pdf_logo",
        "label": "PDF Logo"
      },
      {
        "type": "image_picker",
        "id": "download_logo",
        "label": "Download Logo"
      }
    ],
    "blocks": [
      {
        "type": "product_filter",
        "name": "Product Filter",
        "limit": 1
      },
      {
        "type": "lan_filter",
        "name": "Language Filter",
        "limit": 1
      }
    ],
    "presets": [
        {
            "name": "Custom Manual List"
        }
    ]
  }
{% endschema %}