{% liquid
  assign se_stts = section.settings
  assign img_lsit = se_stts.img_list.img.value | reverse
%}

<div class="max-w-[1820px] w-full md:w-[90%] !mx-auto !pb-[25px] md:!pb-15">
  <h2 class="!mb-[20px] md:!mb-12 !text-[26px] md:!text-6xl leading-[1.3] !text-center !text-white !font-bold !pt-[25px] md:!pt-15">
    {{ se_stts.title }}
  </h2>
  {% if se_stts.btn_link != blank %}
    <div class="w-full sticky top-8 flex justify-center z-50 !py-5" style="background-color: {{ se_stts.bg_color }};">
      <a
        href="{{ se_stts.btn_link }}"
        class="inline-block !py-[10px] !px-[38px] md:!py-4 md:!px-14 !text-[#121212] bg-[#f2cb04] rounded-lg !text-[14px] md:!text-2xl !font-semibold cursor-pointer"
      >
        {{ se_stts.btn }}
      </a>
    </div>
  {% endif %}
  <div class="waterfall-container !mt-[30px] md:!mt-20">
    <div class="waterfall-grid">
      <div class="loading-overlay">
        <div class="loading-spinner"></div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-center !mt-[30px] md:!mt-[50px]">
    <div class=" w-full h-[1px] bg-[#2b2b2b]"></div>
    <div class=" size-[6px] rounded-full bg-[#2b2b2b] !mx-[10px] grow-0 shrink-0"></div>
    <div class=" w-full h-[1px] bg-[#2b2b2b]"></div>
  </div>
</div>

<style>
  .custom-masonry-section {
    background-color: {{ se_stts.bg_color}};
    height: auto;
    padding: 0 10px;
  }


  .waterfall-container {
    width: 100%;
    position: relative;
  }

  .waterfall-grid {
    position: relative;
    width: 100%;
    min-height: 200px;
  }

  .waterfall-item {
    position: absolute;
    width: 100%;
    transition: all 0.5s ease;
    opacity: 0;
    transform: translateY(20px);
  }

  .waterfall-item.loaded {
    opacity: 1;
    transform: translateY(0);
  }

  .waterfall-item img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  /* 加载动画样式 */
  .loading-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 10;
    transition: opacity 0.3s ease;
  }

  .loading-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #f2cb04;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 15px;
  }

  .loading-text {
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* 图片占位符 */
  .waterfall-item::before {
    content: '';
    display: block;
    width: 100%;
    height: 200px;
    background: linear-gradient(90deg, #2b2b2b 25%, #3a3a3a 50%, #2b2b2b 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 8px;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  .waterfall-item.loaded::before {
    display: none;
  }

  /* 占位符样式 */
  .waterfall-item.placeholder {
    background: linear-gradient(90deg, #2b2b2b 25%, #3a3a3a 50%, #2b2b2b 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 8px;
  }

  .waterfall-item.placeholder.loaded {
    background: none;
    animation: none;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  /* 响应式设计 */
  @media (max-width: 767px) {
    .waterfall-item {
      width: calc((100% - 10px) / 2);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .waterfall-item {
      width: calc((100% - 20px) / 3);
    }
  }

  @media (min-width: 1024px) {
    .waterfall-item {
      width: calc((100% - 30px) / 4);
    }
  }
</style>

<script>
  (function () {
    const list = [
    {% for img in img_lsit %}
      {
        url: "{{ img |  image_url  }}",
        width: "{{ img.width }}",
        height: "{{ img.height }}",
        alt: "{{ img.alt | escape }}"
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
    const waterfallContainer = document.querySelector('.waterfall-container');
    const waterfallGrid = document.querySelector('.waterfall-grid');
    const loadingOverlay = document.querySelector('.loading-overlay');

    let loadedImages = 0;
    let currentBatch = 0;
    const batchSize = 20; // 每批加载20张图片
    const totalImages = list.length;
    const imageData = [];
    let isLayoutPerformed = false;
    let isLoading = false;
    let hasMoreImages = true;

    // 创建图片元素
    function createImageElements() {
      // 先创建占位符布局
      createPlaceholderLayout();

      // 加载第一批图片
      loadNextBatch();
    }

    // 加载下一批图片
    function loadNextBatch() {
      if (isLoading || !hasMoreImages) return;

      isLoading = true;
      const startIndex = currentBatch * batchSize;
      const endIndex = Math.min(startIndex + batchSize, totalImages);

      // 显示加载动画
      if (currentBatch === 0) {
        loadingOverlay.classList.remove('hidden');
      }

      // 创建当前批次的图片元素
      for (let i = startIndex; i < endIndex; i++) {
        const item = list[i];
        const div = document.createElement('div');
        div.className = 'waterfall-item';
        div.dataset.index = i;
        const img = document.createElement('img');
        img.src = item.url;
        img.width=item.width;
        img.height=item.height
        img.alt = item.alt || 'Waterfall image';
        img.loading = 'lazy';
        img.style.opacity = '0';

        // 图片加载完成后的处理
        img.onload = function () {
          const aspectRatio = img.naturalHeight / img.naturalWidth;
          imageData[i] = {
            element: div,
            aspectRatio: aspectRatio,
            loaded: true,
          };

          // 显示图片
          img.style.opacity = '1';
          div.classList.add('loaded');

          loadedImages++;
          checkBatchComplete();
        };

        img.onerror = function () {
          imageData[i] = {
            element: div,
            aspectRatio: 1, // 默认比例
            loaded: true,
          };

          // 即使加载失败也显示占位符
          div.classList.add('loaded');

          loadedImages++;
          checkBatchComplete();
        };

        div.appendChild(img);
        waterfallGrid.appendChild(div);
      }
    }

    // 检查批次是否完成
    function checkBatchComplete() {
      const currentBatchEnd = Math.min((currentBatch + 1) * batchSize, totalImages);

      if (loadedImages >= currentBatchEnd) {
        // 当前批次完成，执行布局
        performWaterfallLayout();

        // 隐藏加载动画
        if (currentBatch === 0) {
          setTimeout(() => {
            loadingOverlay.classList.add('hidden');
          }, 500);
        }

        // 检查是否还有更多图片
        if (currentBatchEnd >= totalImages) {
          hasMoreImages = false;
        }

        isLoading = false;
      }
    }

    // 创建占位符布局
    function createPlaceholderLayout() {
      const containerWidth = waterfallContainer.offsetWidth;
      const gap = 10;

      // 根据屏幕宽度确定列数
      let columns = 4;
      let itemWidth = (containerWidth - (columns - 1) * gap) / columns;

      if (window.innerWidth <= 767) {
        columns = 2;
        itemWidth = (containerWidth - (columns - 1) * gap) / columns;
      } else if (window.innerWidth <= 1023) {
        columns = 3;
        itemWidth = (containerWidth - (columns - 1) * gap) / columns;
      }

      // 只创建第一批的占位符
      const initialCount = Math.min(batchSize, totalImages);

      for (let i = 0; i < initialCount; i++) {
        const div = document.createElement('div');
        div.className = 'waterfall-item placeholder';
        div.style.width = itemWidth + 'px';
        div.style.height = '200px'; // 默认高度

        const columnIndex = i % columns;
        const rowIndex = Math.floor(i / columns);
        const x = columnIndex * (itemWidth + gap);
        const y = rowIndex * (200 + gap);

        div.style.left = x + 'px';
        div.style.top = y + 'px';

        waterfallGrid.appendChild(div);
      }

      // 设置初始容器高度
      const rows = Math.ceil(initialCount / columns);
      const initialHeight = rows * (200 + gap) - gap;
      waterfallGrid.style.height = initialHeight + 'px';
    }

    // 执行瀑布流布局
    function performWaterfallLayout() {
      const containerWidth = waterfallContainer.offsetWidth;
      const gap = 10;

      // 根据屏幕宽度确定列数
      let columns = 4;
      let itemWidth = (containerWidth - (columns - 1) * gap) / columns;

      if (window.innerWidth <= 767) {
        columns = 2;
        itemWidth = (containerWidth - (columns - 1) * gap) / columns;
      } else if (window.innerWidth <= 1023) {
        columns = 3;
        itemWidth = (containerWidth - (columns - 1) * gap) / columns;
      }

      // 初始化列高度
      const columnHeights = new Array(columns).fill(0);
      const columnItems = new Array(columns).fill().map(() => []);

      // 按从左往右、从上往下的顺序分配图片
      imageData.forEach((data, index) => {
        if (!data || !data.loaded) return;

        // 找到高度最小的列
        const minHeight = Math.min(...columnHeights);
        const targetColumn = columnHeights.indexOf(minHeight);

        // 计算图片高度
        const itemHeight = itemWidth * data.aspectRatio;

        // 将图片添加到目标列
        columnItems[targetColumn].push({
          element: data.element,
          height: itemHeight,
          index: index,
        });

        // 更新列高度
        columnHeights[targetColumn] += itemHeight + gap;
      });

      // 重新排列DOM元素并设置位置
      waterfallGrid.innerHTML = '';

      // 重新添加加载动画
      const newLoadingOverlay = document.createElement('div');
      newLoadingOverlay.className = 'loading-overlay hidden';
      newLoadingOverlay.innerHTML = `
        <div class="loading-spinner"></div>
        <div class="loading-text">加载中...</div>
      `;
      waterfallGrid.appendChild(newLoadingOverlay);

      columnItems.forEach((column, columnIndex) => {
        let currentY = 0;

        column.forEach((item, itemIndex) => {
          const x = columnIndex * (itemWidth + gap);
          const y = currentY;

          item.element.style.left = x + 'px';
          item.element.style.top = y + 'px';
          item.element.style.width = itemWidth + 'px';

          currentY += item.height + gap;
          waterfallGrid.appendChild(item.element);
        });
      });

      // 设置容器高度
      const maxHeight = Math.max(...columnHeights);
      waterfallGrid.style.height = maxHeight + 'px';

      // 隐藏加载动画
      setTimeout(() => {
        if (newLoadingOverlay) {
          newLoadingOverlay.classList.add('hidden');
        }
      }, 500);
    }

    // 检查滚动位置
    function checkScroll() {
      if (!hasMoreImages || isLoading) return;

      const waterfallContainerRect = waterfallContainer.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // 计算触发加载的阈值
      // 当瀑布流容器的底部距离视窗底部小于300px时触发加载
      // 这样可以确保用户在浏览到接近已加载内容时就开始加载新内容
      const triggerThreshold = 300;

      if (waterfallContainerRect.bottom <= windowHeight + triggerThreshold && waterfallContainerRect.bottom > 0) {
        // 防止重复触发
        if (!isLoading) {
          currentBatch++;
          loadNextBatch();
        }
      }
    }

    // 防抖函数
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // 监听窗口大小变化
    const debouncedResize = debounce(() => {
      performWaterfallLayout();
    }, 250);

    // 监听滚动事件
    const debouncedScroll = debounce(checkScroll, 100);

    window.addEventListener('resize', debouncedResize);
    window.addEventListener('scroll', debouncedScroll);

    // 初始化
    createImageElements();
  })();
</script>

{% schema %}
{
  "name": "Masonry",
  "tag": "section",
  "class": "custom-masonry-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Student Assistant"
    },
    {
      "type": "text",
      "id": "btn",
      "label": "按钮文本",
      "default": "Explore Models"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "跳转链接"
    },
    {
      "type": "metaobject",
      "id": "img_list",
      "label": "图片集合",
      "metaobject_type": "gallery"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Masonry",
      "category": "Custom Home"
    }
  ]
}
{% endschema %}
