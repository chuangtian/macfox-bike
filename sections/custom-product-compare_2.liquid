{% liquid
  assign se_stts = section.settings
%}
<div class="--product-wrapper" data-is_expanded="false">
  <div class="--compare-img">
    <img
      src="{{ se_stts.img |  image_url: width:se_stts.img.width  }}"
      width="{{ se_stts.img.width }}"
      height="{{ se_stts.img.height }}"
      alt="{{ se_stts.img.alt }}"
    >
  </div>
  <p class="--compare-title">{{ se_stts.title }}</p>
  <p class="--compare-desc">{{ se_stts.desc }}</p>
  <button class="--compare-btn" type="button" onclick="productCompareOn()">{{ se_stts.btn_content }}</button>
</div>

<div class="--product-compare">
  <div class="--product-compare-overflow" onclick="productCompareOff()"></div>
  <div class="--product-compare-main">
    <div class="--product-compare-control">
      <div class="--product-compare-control-item">
        <svg width="100%" height="100%" viewBox="0 0 65 66" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M52.8 65.5H13.2C6.70002 65.5 1.40002 60.2 1.40002 53.7V13.2C1.40002 6.69999 6.70002 1.39999 13.2 1.39999H52.7C59.2 1.39999 64.5 6.69999 64.5 13.2V53.7C64.5 60.3 59.3 65.5 52.8 65.5Z" fill="#1E1E1E" stroke="#666666" stroke-width="0.9603" stroke-miterlimit="10"/>
          <path d="M21.7001 22L44.3001 45" stroke="#828282" stroke-width="3.8412" stroke-miterlimit="10"/>
          <path d="M44.3001 22L21.7001 45" stroke="#828282" stroke-width="3.8412" stroke-miterlimit="10"/>
        </svg>
      </div>
    </div>
    <div class="--product-compare-content">
      {{ se_stts.content }}
    </div>
  </div>
</div>

<script type="module" src="{{  "custom-product-compare_2.min.js" |  asset_url}}"></script>
{% schema %}
{
  "name": "产品比较 v2",
  "tag": "section",
  "class": "cs-product-compare_2-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "img",
      "label": "图片"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Product Compare"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "描述",
      "default": "Movein past the X1S wit5h thicker tires and a sculpted wide-body design.The X7 delivers the ultimate visual impact and the highest level of stability for a truly fearless drive."
    },
    {
      "type": "text",
      "id": "btn_content",
      "label": "按钮文本",
      "default": "Compare X7 vs X1S"
    },
    {
      "type": "html",
      "id": "content",
      "label": "内容（HTML）"
    }
  ],
  "presets": [
    {
      "name": "产品比较 v2",
      "category": "product"
    }
  ]
}
{% endschema %}
