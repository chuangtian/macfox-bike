<section
  id="macfox-community-reviews-{{ section.id }}"
  class="macfox-community-reviews"
  data-review-section
>
  <div class="macfox-community-reviews__inner">
    <div class="macfox-community-reviews__head">
      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.view_all_url != blank %}
        <a
          class="macfox-community-reviews__all"
          href="{{ section.settings.view_all_url }}"
          target="_blank"
          rel="nofollow noopener noreferrer"
        >
          {{ section.settings.view_all_text }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    <div class="macfox-community-reviews__rail-wrap">
      <button class="macfox-community-reviews__nav is-prev" type="button" aria-label="Previous reviews">
        <span aria-hidden="true">&lsaquo;</span>
      </button>

      <div class="macfox-community-reviews__rail" data-review-rail>
        {% for block in section.blocks %}
          {% assign platform = block.settings.platform %}
          {% assign is_video = false %}
          {% if platform == 'youtube' or platform == 'instagram' or platform == 'tiktok' %}
            {% assign is_video = true %}
          {% endif %}

          <article class="macfox-community-reviews__card" {{ block.shopify_attributes }}>
            <a
              class="macfox-community-reviews__media"
              href="{{ block.settings.review_url }}"
              target="_blank"
              rel="nofollow noopener noreferrer"
              aria-label="{{ block.settings.title | escape }}"
            >
              {% if block.settings.thumbnail != blank %}
                <img
                  src="{{ block.settings.thumbnail | image_url: width: 720 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="{{ block.settings.thumbnail.width }}"
                  height="{{ block.settings.thumbnail.height }}"
                  loading="lazy"
                >
              {% elsif block.settings.youtube_id != blank %}
                <img
                  src="https://img.youtube.com/vi/{{ block.settings.youtube_id }}/hqdefault.jpg"
                  alt="{{ block.settings.title | escape }}"
                  width="720"
                  height="405"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'macfox-community-reviews__placeholder' }}
              {% endif %}

              <span class="macfox-community-reviews__platform">
                {{ platform | capitalize }}
              </span>

              {% if is_video %}
                <span class="macfox-community-reviews__play" aria-hidden="true"></span>
              {% endif %}
            </a>

            <div class="macfox-community-reviews__body">
              <h3>
                <a
                  href="{{ block.settings.review_url }}"
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                >
                  {{ block.settings.title }}
                </a>
              </h3>

              {% if block.settings.excerpt != blank %}
                <p>{{ block.settings.excerpt }}</p>
              {% endif %}

              <div class="macfox-community-reviews__source">
                {% if block.settings.author_image != blank %}
                  <img
                    src="{{ block.settings.author_image | image_url: width: 80 }}"
                    alt="{{ block.settings.source_name | escape }}"
                    width="40"
                    height="40"
                    loading="lazy"
                  >
                {% endif %}
                <span>{{ block.settings.source_name }}</span>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      <button class="macfox-community-reviews__nav is-next" type="button" aria-label="Next reviews">
        <span aria-hidden="true">&rsaquo;</span>
      </button>
    </div>

    <div class="macfox-community-reviews__progress" aria-hidden="true">
      <span data-review-progress></span>
    </div>
  </div>
</section>

<style>
  #macfox-community-reviews-{{ section.id }} {
    background: #fff;
    color: #111;
    padding: 72px 0;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__inner {
    width: min(100% - 40px, 1360px);
    margin: 0 auto;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  #macfox-community-reviews-{{ section.id }} h2 {
    margin: 0;
    color: #111;
    font-size: 34px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__all {
    color: #111;
    font-size: 14px;
    line-height: 1;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__rail-wrap {
    position: relative;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 1fr);
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0 0 12px;
    scrollbar-width: none;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__rail::-webkit-scrollbar {
    display: none;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__card {
    min-width: 280px;
    scroll-snap-align: start;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f3f3f3;
    border-radius: 6px;
    text-decoration: none;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__media img,
  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__platform {
    position: absolute;
    left: 10px;
    top: 10px;
    z-index: 2;
    background: #111;
    color: #fff;
    padding: 5px 8px;
    border-radius: 4px;
    font-size: 11px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 62px;
    height: 62px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #56afe5;
    border: 4px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__play::after {
    content: "";
    position: absolute;
    left: 24px;
    top: 18px;
    width: 0;
    height: 0;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
    border-left: 16px solid #fff;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__body {
    padding-top: 14px;
  }

  #macfox-community-reviews-{{ section.id }} h3 {
    margin: 0;
    font-size: 18px;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: 0;
  }

  #macfox-community-reviews-{{ section.id }} h3 a {
    color: #111;
    text-decoration: none;
  }

  #macfox-community-reviews-{{ section.id }} h3 a:hover {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #macfox-community-reviews-{{ section.id }} p {
    margin: 8px 0 0;
    color: #777;
    font-size: 14px;
    line-height: 1.65;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__source {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    color: #111;
    font-size: 14px;
    font-weight: 600;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__source img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__nav {
    position: absolute;
    top: -54px;
    width: 34px;
    height: 34px;
    border: 1px solid #ddd;
    border-radius: 50%;
    background: #fff;
    color: #111;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 3;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__nav span {
    font-size: 26px;
    line-height: 1;
    transform: translateY(-1px);
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__nav.is-prev {
    right: 44px;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__nav.is-next {
    right: 0;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__nav:hover {
    background: #f2cb04;
    border-color: #f2cb04;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__progress {
    height: 4px;
    margin-top: 26px;
    background: #e5e5e5;
    overflow: hidden;
  }

  #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__progress span {
    display: block;
    width: 18%;
    height: 100%;
    background: #222;
    transition: width 0.2s ease;
  }

  @media (max-width: 767px) {
    #macfox-community-reviews-{{ section.id }} {
      padding: 48px 0;
    }

    #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__inner {
      width: min(100% - 28px, 1360px);
    }

    #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__head {
      align-items: flex-start;
      margin-bottom: 22px;
    }

    #macfox-community-reviews-{{ section.id }} h2 {
      font-size: 28px;
    }

    #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__all {
      font-size: 13px;
    }

    #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__rail {
      grid-auto-columns: 82%;
      gap: 18px;
    }

    #macfox-community-reviews-{{ section.id }} .macfox-community-reviews__nav {
      display: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('#macfox-community-reviews-{{ section.id }}');
    if (!section) return;

    const rail = section.querySelector('[data-review-rail]');
    const progress = section.querySelector('[data-review-progress]');
    const prev = section.querySelector('.macfox-community-reviews__nav.is-prev');
    const next = section.querySelector('.macfox-community-reviews__nav.is-next');

    if (!rail || !progress) return;

    const updateProgress = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const percent = max > 0 ? ((rail.scrollLeft / max) * 82) + 18 : 100;
      progress.style.width = Math.min(100, percent) + '%';
    };

    const scrollAmount = () => {
      const card = rail.querySelector('.macfox-community-reviews__card');
      return card ? card.getBoundingClientRect().width + 24 : rail.clientWidth * 0.8;
    };

    if (prev) {
      prev.addEventListener('click', () => {
        rail.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    }

    if (next) {
      next.addEventListener('click', () => {
        rail.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }

    rail.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  })();
</script>

{% schema %}
{
  "name": "Community Reviews Demo",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Community Reviews"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "See All Reviews"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "default": "youtube",
          "options": [
            { "value": "youtube", "label": "YouTube" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "website", "label": "Review site" },
            { "value": "press", "label": "Press" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Macfox E-bike Review: Real Ride Impressions"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt",
          "default": "A third-party ride review covering comfort, range, handling, and everyday use."
        },
        {
          "type": "text",
          "id": "source_name",
          "label": "Source name",
          "default": "Reviewer Name"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Source avatar or logo"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image"
        },
        {
          "type": "text",
          "id": "youtube_id",
          "label": "YouTube video ID",
          "info": "Used only when no thumbnail image is selected."
        },
        {
          "type": "url",
          "id": "review_url",
          "label": "Review URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community Reviews Demo",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}