<div class=" flex max-w-[1300px] w-[90%] !mx-auto !py-10">
  <div class=" flex flex-col gap-y-[5px] w-1/3">
    {% for lik in menu %}
      <a
        class="!text-white !font-medium hover:!text-[#f2cb04] hover:bg-[#1e1e1e] !px-[15px] !py-[10px] rounded-sm w-fit"
        href="{{ lik.url }}"
      >
        {{- lik.title -}}
      </a>
    {% endfor %}
  </div>
  <div class=" flex-1">
    <div class=" !text-white"></div>
    <div class="flex items-end justify-between !mb-4">
      <span class="!text-white !text-[18px] !font-medium">Latest Blog</span>
      <a class="!text-[#f2cb04] !text-[16px]  !underline" href="{{ blogs[bl_handle].url }}">Read All</a>
    </div>
    <div class="flex gap-x-5">
      {% for art in blogs[bl_handle].articles limit: 3 %}
        <a class="w-1/3 group/community" href="{{ art.url }}">
          <img
            class=" rounded-xl aspect-4/3 object-cover"
            src="{{ art.image.src |  image_url: width:300  }}"
            width="{{ art.image.width }}"
            height="{{ art.image.height }}"
            alt="{{ art.image.alt}}"
          >
          <p class="!text-[#cccccc] !text-[14px] !font-medium !mt-[10px] !leading-[1.6] line-clamp-2 group-hover/community:!text-[#fff]">
            {{ art.title }}
          </p>
        </a>
      {% endfor %}
    </div>
  </div>
</div>
