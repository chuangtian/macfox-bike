<div class=" flex flex-col gap-y-[5px] !px-[15px] !py-[15px]">
  {% for drop_item in link_list %}
    <a
      class=" text-nowrap text-center !py-[10px] rounded-sm hover:bg-[#1e1e1e] !text-white hover:!text-[#f2cb04] !px-[15px] !font-medium"
      href="{{ drop_item.url }}"
    >
      {{- drop_item.title -}}
    </a>
  {% endfor %}
</div>
