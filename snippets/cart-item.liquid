{%- liquid
  assign item_id = item.id
  assign item_key = item.key
  assign item_url = item.url
  assign image = item.image
-%}

<div data-hulkapps-lineitem 
  data-cart-item
  class="
    t4s-mini_cart__item cart_item_{{item_id}} t4s-oh
    {% if size > 1 %} --item-divided{% endif %}
    {% if index == 1 %} --item-first{% endif %}
    {% if gift_pr_id == item.product_id %} is--gift{% endif %}
  "
>
  <a
    href="{{item_url}}"
    class="t4s-mini_cart__img t4s-pr t4s-oh t4s_ratio t4s-bg-1"
    style="--aspect-ratioapt:{{image.aspect_ratio |default: 1}}"
  >
    {%- if image != blank -%}
      <img
        class="lazyloadt4s"
        width="120"
        height="{{ 120 | divided_by: image.aspect_ratio | ceil }}"
        src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
        data-src="{{ image | image_url: width: 1 }}"
        data-widths="[120, 240]"
        data-sizes="auto"
        alt="{{ image.alt | escape }}"
      >
    {%- endif -%}
    <div class="t4s-cart-ld__bar t4s-pe-none t4s-dn" hidden>
      <span>
        <svg
          width="16"
          height="16"
          hidden
          class="t4s-cart-spinner"
          focusable="false"
          role="presentation"
          viewBox="0 0 66 66"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle class="t4s-path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
        </svg>
        <svg class="t4s-cart-check" viewBox="0 0 448 512" width="16" height="16" hidden>
          <use href="#icon-cart-check"/>
        </svg>
      </span>
    </div>
  </a>
  <div class="t4s-mini_cart__info">
    <a
      href="{{item_url}}"
      class="t4s-mini_cart__title"
    >
      {{- item.product.title -}}
    </a>
    {%- assign qv_key = item.product.id -%}
    {%- unless item.product.has_only_default_variant or item.variant.title contains 'mczr_price_' -%}
      {%- assign qv_key = item_id -%}
      <p class="t4s-cart_meta_variant">
        {{ item.variant.title }}
      </p>
    {%- endunless -%}
    {%- if item.selling_plan_allocation != blank %}
      <p class="t4s-cart_selling_plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {% endif -%}
    {%- assign property_size = item.properties | size -%}
    {%- if property_size > 0 -%}
      <ul  data-hulkapps-line-properties class="cart_meta_propertyList">
        {%- for p in item.properties -%}
          {%- if p.first contains '_bundle_' or p.first contains '_mczr_' -%}{%- continue -%}{%- endif -%}
          {%- unless p.last == blank -%}
            {%- if p.first == 'shipping_interval_frequency' -%}
              {%- assign frequency = p.last -%}
              {%- assign recurringchecked = true -%}
              {%- continue -%}
            {%- elsif p.first == 'shipping_interval_unit_type' -%}
              {%- if frequency == '1' -%}
                {%- if p.last == 'Days' -%}
                  {%- assign frequency_unit = 'Day' -%}
                {%- elsif p.last == 'Months' -%}
                  {% assign frequency_unit = 'Month' -%}
                {%- elsif p.last == 'Weeks' -%}
                  {%- assign frequency_unit = 'Week' -%}
                {%- endif -%}
              {%- else -%}
                {%- assign frequency_unit = p.last -%}
              {%- endif -%}
              {%- continue -%}
            {%- endif -%}

            <li class="t4s-product-details__item product-details__item--property">
              <span class="t4s-product-details__item-label"
                ><strong>{{ p.first }}:</strong>
              </span>
              <span>
                {%- if p.last contains '/uploads/' -%}
                  <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                {%- else -%}
                  {{ p.last }}
                {%- endif -%}
              </span>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
<button type='button' style='display: none;' class='edit_cart_option btn btn--primary button' data-product_id='{{item.product_id}}' data-key='{{item.key}}' data-variant_id='{{item.variant_id}}' data-quantity='{{item.quantity}}'>Edit Options</button>
    {%- endif -%}
    {%- if recurringchecked -%}
      <span class="t4s-product-details__item-recurring t4s-ch">
        {{- 'cart.general.recurring_mess' | t: frequency: frequency, frequency_unit: frequency_unit -}}
      </span>
    {%- endif -%}
    <div class="t4s-cart_price">
      {%- assign item_compare_price = item.variant.compare_at_price
        | default: item.original_price
        | times: item.quantity
      -%}
      {%- assign compare_tt_price = compare_tt_price | plus: item_compare_price -%}
      {%- if item.original_price != item.final_price -%}
        <ins  data-hulkapps-ci-price data-key='{{item.key}}' class="">{{ item.final_price | money }}</ins>
        <del  data-hulkapps-ci-price data-key='{{item.key}}'>{{ item.original_price | money }}</del>
      {%- elsif item.variant.compare_at_price > item.original_price -%}
        <ins  data-hulkapps-ci-price data-key='{{item.key}}' class="">{{ item.final_price | money }}</ins>
        <del>{{ item.variant.compare_at_price | money }}</del>
      {%- else -%}
        <span data-hulkapps-ci-price data-key='{{item.key}}'>{{ item.original_price | money }}</span>
      {%- endif -%}
    </div>
    {%- if item.unit_price_measurement -%}
      {%- capture unit_price_base_unit -%}
               {%- if item.unit_price_measurement.reference_value != 1 -%}
                 {{- item.unit_price_measurement.reference_value -}}
               {%- endif -%}
               {{ item.unit_price_measurement.reference_unit }}
             {%- endcapture -%}
      <div class="t4s-cart_unit_price">
        {{ item.unit_price | money -}}
        <span>/</span>
        {{- unit_price_base_unit -}}
      </div>
    {%- endif -%}
    {%- if item.line_level_discount_allocations != blank -%}
      <ul class="t4s-cart_discount_price">
        {%- for discount_allocation in item.line_level_discount_allocations -%}
          <li class="t4s-order-discount__item">
            <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0.200012 5.60001V1.20001C0.200012 0.600012 0.700012 0.200012 1.20001 0.200012H5.70001C6.00001 0.200012 6.40001 0.200012 6.70001 0.500012L13.3 7.10001C13.5 7.30001 13.5 7.50001 13.5 7.70001C13.5 7.90001 13.4 8.10001 13.3 8.30001L8.30001 13.3C8.10001 13.5 7.90001 13.5 7.70001 13.5C7.50001 13.5 7.30001 13.4 7.10001 13.3L0.500012 6.70001C0.200012 6.40001 0.200012 6.00001 0.200012 5.60001ZM3.60001 4.70001C4.20001 4.70001 4.70001 4.20001 4.70001 3.60001C4.70001 3.00001 4.20001 2.50001 3.60001 2.50001C3.00001 2.50001 2.50001 3.00001 2.50001 3.60001C2.50001 4.20001 3.00001 4.70001 3.60001 4.70001Z" fill="#CCCCCC"/>
            </svg>

            {{ discount_allocation.discount_application.title }}
            <span>(-{{ discount_allocation.amount | money }})</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="t4s-mini_cart__actions">
      <div
        data-quantity-wrapper
        class="t4s-quantity-wrapper t4s-quantity-cart-item"
      >
        <button
          data-quantity-selector
          data-decrease-qty
          type="button"
          class="t4s-quantity-selector is--minus"
        >
          {%- comment -%} PC 保留母主题实心图标 {%- endcomment -%}
          <svg focusable="false" class="icon icon--minus --qty-icon-pc" viewBox="0 0 10 2" role="presentation">
            <path d="M10 0v2H0V0z" fill="currentColor"></path>
          </svg>
          {%- comment -%} 移动端按设计稿 tips/minus：14px，2px 圆头描边 {%- endcomment -%}
          <svg class="--qty-icon-mb" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M2 7H12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
        <input
          data-action-change
          data-quantity-value
          type="number"
          id="miniupdates_{{item_key}}"
          data-id="{{item_key}}"
          step="1"
          min="{{min_qty}}"
          max="{% if item.variant.inventory_management == blank or item.variant.inventory_policy == 'continue' %}9999{% else %}{{ item.variant.inventory_quantity }}{% endif %}"
          name="updates[]"
          value="{{ item.quantity }}"
          size="4"
          pattern="[0-9]*"
          inputmode="numeric"
        >
        <button
          data-quantity-selector
          data-increase-qty
          type="button"
          class="t4s-quantity-selector is--plus"
        >
          {%- comment -%} PC 保留母主题实心图标 {%- endcomment -%}
          <svg focusable="false" class="icon icon--plus --qty-icon-pc" viewBox="0 0 10 10" role="presentation">
            <path d="M6 4h4v2H6v4H4V6H0V4h4V0h2v4z" fill="currentColor" fill-rule="evenodd"></path>
          </svg>
          {%- comment -%} 移动端按设计稿 tips/plus：14px，2px 圆头描边 {%- endcomment -%}
          <svg class="--qty-icon-mb" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M2 7H12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M7 12L7 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      {% comment %}
        {%- unless item.product.has_only_default_variant -%}
          <a
            href="{{item_url}}"
            rel="nofollow"
            class="t4s-mini_cart__edit"
            data-action-quickshop
            data-edit="{{edit_item}}"
            data-id="{{qv_key}}"
            data-key="{{item_key}}"
            data-no-instant
            data-id="{{qv_key}}"
            data-tooltip="top-start"
            data-t4s-tooltip="{{ 'cart.general.edit_item' | t | escape }}"
          >
            <svg viewBox="0 0 24 24" width="20" height="20">
              <use href="#icon-cart-edit"/>
            </svg>
          </a>
        {%- endunless -%}
      {% endcomment %}
      <a
        href="{{cart_change_url}}?quantity=0&amp;id={{item_key}}"
        rel="nofollow"
        class="t4s-mini_cart__remove"
        data-no-instant
        data-cart-remove
        data-id="{{item_key}}"
        data-tooltip="top-start"
        data-t4s-tooltip="{{ 'cart.general.remove_item' | t | escape }}"
      >
        <svg viewBox="0 0 24 24" width="17">
          <use href="#icon-cart-remove"/>
        </svg>
      </a>
    </div>
  </div>
</div>